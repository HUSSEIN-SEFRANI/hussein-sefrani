#!/usr/bin/env python3
"""HOME ANAB installer — runs as root inside the live system booted from the USB stick.

It serves the installer screens on http://127.0.0.1:9999 (shown full screen by the
TV kiosk) and copies the live system itself onto the chosen disk:

    1 welcome & language   2 network (cable or Wi-Fi)   3 choose disk   4 prepare disk
    5 copy system          6 configure HOME ANAB        7 boot loader

Everything needed is on the stick: no internet connection is used. The network step only
joins the home network (cable or Wi-Fi) so the server gets an address, and the Wi-Fi
chosen here is kept on the installed system.
"""
import json
import os
import re
import secrets
import shutil
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

UI = Path(os.environ.get("HSEF_INSTALLER_UI", "/usr/local/share/hsef-installer"))
SOURCE = Path(os.environ.get("HSEF_INSTALLER_SOURCE", "/run/live/rootfs/filesystem.squashfs"))
TARGET = Path("/target")
FAKE = os.environ.get("HSEF_INSTALLER_FAKE") == "1"   # tests: no disk is touched
LOG = Path("/var/log/hsef-installer.log")
VERSION = "?"
try:
    VERSION = re.search(r'__version__ = "(.+?)"', (SOURCE / "opt/homenas/app/homenas/__init__.py").read_text()).group(1)
except Exception:
    try:
        VERSION = re.search(r'__version__ = "(.+?)"', Path("/opt/homenas/app/homenas/__init__.py").read_text()).group(1)
    except Exception:
        pass

STEPS = ["welcome", "network", "disk", "prepare", "copy", "configure", "boot"]
# حصة كل خطوة من شريط التقدم الكلي
WEIGHTS = {"prepare": (0, 5), "copy": (5, 75), "configure": (75, 93), "boot": (93, 100)}

state = {"stage": "welcome", "step": 0, "percent": 0, "detail": "", "error": None, "hint": None,
         "lang": "ar", "version": VERSION, "started": None, "eta_min": None}
lock = threading.Lock()


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(time.strftime("%H:%M:%S ") + msg + "\n")
    except OSError:
        pass


def set_state(**kw):
    with lock:
        state.update(kw)
        if state.get("started") and 3 < state["percent"] < 100:
            el = time.time() - state["started"]
            state["eta_min"] = max(1, round(el / state["percent"] * (100 - state["percent"]) / 60))


def progress(step, frac, detail=None):
    a, b = WEIGHTS[step]
    set_state(step=STEPS.index(step), percent=round(a + (b - a) * max(0, min(1, frac)), 1),
              **({"detail": detail} if detail is not None else {}))


class Fail(Exception):
    def __init__(self, msg, hint=None):
        super().__init__(msg)
        self.hint = hint


def run(cmd, check=True, **kw):
    log("$ " + " ".join(map(str, cmd)))
    if FAKE:
        time.sleep(0.2)
        return subprocess.CompletedProcess(cmd, 0, "", "")
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if r.stdout:
        log(r.stdout[-2000:])
    if r.stderr:
        log(r.stderr[-2000:])
    if check and r.returncode != 0:
        raise Fail(f"{cmd[0]}: {(r.stderr or r.stdout).strip()[-300:]}")
    return r


# ----------------------------------------------------------------------------- الأقراص
def boot_disk() -> str | None:
    """القرص الذي أقلعنا منه (الفلاشة) حتى لا يظهر في القائمة."""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/run/live/medium"], capture_output=True, text=True).stdout.strip()
        if src:
            pk = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True, text=True).stdout.strip()
            return pk or Path(src).name
    except OSError:
        pass
    return None


def disks() -> list:
    if FAKE:
        return [{"name": "sda", "path": "/dev/sda", "size": 500107862016, "model": "Samsung SSD 870 EVO", "tran": "sata", "rota": False},
                {"name": "sdb", "path": "/dev/sdb", "size": 2000398934016, "model": "WDC WD20EZRZ", "tran": "sata", "rota": True}]
    out = subprocess.run(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,TYPE,TRAN,RM,ROTA,RO"], capture_output=True, text=True).stdout
    skip = boot_disk()
    res = []
    for d in json.loads(out or "{}").get("blockdevices", []):
        if d.get("type") != "disk" or d.get("ro") in (True, "1") or d["name"] == skip:
            continue
        if re.match(r"^(loop|sr|zram|ram|fd)", d["name"]) or int(d.get("size") or 0) < 8 * 1024 ** 3:
            continue
        res.append({"name": d["name"], "path": d["path"], "size": int(d["size"]), "model": (d.get("model") or "").strip(),
                    "tran": d.get("tran") or "", "rota": d.get("rota") in (True, "1")})
    return res


def part(disk: str, n: int) -> str:
    return f"{disk}p{n}" if re.search(r"\d$", disk) else f"{disk}{n}"


# ----------------------------------------------------------------------------- الشبكة: كابل أو وايفاي
# نفس الملفات التي تستعملها إعدادات النظام (hsef-extras)، فتظهر الشبكة هناك بعد التثبيت ويمكن تغييرها
WIFI_CONF = Path("etc/wpa_supplicant/hsef-wifi.conf")
WIFI_FILE = Path("etc/network/interfaces.d/hsef-wifi")
SYSCTL_NET = Path("etc/sysctl.d/90-hsef-net.conf")
WPA_PID = Path("/run/hsef-installer-wpa.pid")
wifi_lock = threading.Lock()
wifi = {}            # الشبكة المختارة {iface, ssid, psk} — لا تُرسل كلمة المرور إلى الواجهة أبداً
fake_net = {"wired_ip": os.environ.get("HSEF_INSTALLER_FAKE_CABLE") or None, "wifi_ip": None,   # للاختبار فقط
            "wifi": os.environ.get("HSEF_INSTALLER_FAKE_NOWIFI") != "1"}
_wired_tried = set()


def sh(cmd, timeout=30) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 1, "", str(e))


def links() -> list:
    try:
        return json.loads(sh(["ip", "-j", "addr"]).stdout or "[]")
    except ValueError:
        return []


def ipv4(l) -> str | None:
    return next((a.get("local") for a in l.get("addr_info", []) if a.get("family") == "inet"), None)


def is_wired(n: str) -> bool:
    return n != "lo" and not n.startswith(("wl", "docker", "veth", "br-", "tailscale", "virbr", "tun", "tap"))


def net_info() -> dict:
    if FAKE:
        return {"wired": {"iface": "enp1s0", "cable": bool(fake_net["wired_ip"]), "ip": fake_net["wired_ip"]},
                "wifi": {"iface": "wlan0" if fake_net["wifi"] else None, "ssid": wifi.get("ssid"), "ip": fake_net["wifi_ip"]}}
    wired, wl = None, None
    for l in links():
        n = l.get("ifname", "")
        if n.startswith("wl"):
            wl = wl or l
        elif is_wired(n) and l.get("link_type") == "ether":
            # الأولوية لمنفذ فيه كابل
            up = "LOWER_UP" in l.get("flags", [])
            if not wired or (up and "LOWER_UP" not in wired.get("flags", [])):
                wired = l
    if wired and "LOWER_UP" in wired.get("flags", []) and not ipv4(wired):
        wired_dhcp(wired["ifname"])
    return {"wired": {"iface": wired and wired["ifname"], "cable": bool(wired and "LOWER_UP" in wired.get("flags", [])),
                      "ip": wired and ipv4(wired)},
            "wifi": {"iface": wl and wl["ifname"], "ssid": wifi.get("ssid") if wl and ipv4(wl) else None, "ip": wl and ipv4(wl)}}


def wired_dhcp(n: str):
    """الكابل موصول بلا عنوان: نطلب عنواناً من الراوتر (مرة واحدة لكل منفذ)."""
    if n in _wired_tried:
        return
    _wired_tried.add(n)
    log(f"dhcp on {n}")
    sh(["dhcpcd", "-4", "-b", n])


def wired_up():
    """عند البدء: نشغّل منافذ الكابل حتى يُعرف إن كان فيها كابل."""
    if FAKE:
        return
    for l in links():
        if is_wired(l.get("ifname", "")) and l.get("link_type") == "ether":
            sh(["ip", "link", "set", l["ifname"], "up"])


def rfkill_unblock():
    """بعض الأجهزة تبدأ والوايفاي مقفول برمجياً."""
    if sh(["rfkill", "unblock", "wifi"]).returncode != 0:
        for f in Path("/sys/class/rfkill").glob("rfkill*/soft"):
            try:
                f.write_text("0")
            except OSError:
                pass


def wifi_iface() -> str | None:
    return next((l["ifname"] for l in links() if l.get("ifname", "").startswith("wl")), None)


def iw_ssid(raw: str) -> str:
    """iw يكتب الأحرف غير الإنكليزية بشكل \\xNN: نعيدها نصاً (العربية مثلاً)."""
    b = re.sub(rb"\\x([0-9a-fA-F]{2})", lambda m: bytes([int(m.group(1), 16)]), raw.encode("utf-8", "surrogateescape"))
    return b.decode("utf-8", "replace")


def wifi_scan() -> list:
    if FAKE:
        time.sleep(1)
        return [{"ssid": "Home-WiFi", "signal": -42, "secure": True}, {"ssid": "بيت أبو أنس", "signal": -58, "secure": True},
                {"ssid": "Proximus-Home-5G", "signal": -66, "secure": True}, {"ssid": "telenet-7F3A21", "signal": -74, "secure": True},
                {"ssid": "Free WiFi", "signal": -80, "secure": False}, {"ssid": "Neighbour", "signal": -86, "secure": True}]
    wi = wifi_iface()
    if not wi:
        return []
    rfkill_unblock()
    sh(["ip", "link", "set", wi, "up"])
    out = ""
    for _ in range(3):  # البطاقة قد تكون مشغولة لحظة البحث
        r = sh(["iw", "dev", wi, "scan"], timeout=40)
        if r.returncode == 0:
            out = r.stdout
            break
        time.sleep(2)
    nets, cur = {}, None

    def keep(c):
        if c and c.get("ssid") and not c["ssid"].startswith("\x00"):
            old = nets.get(c["ssid"])
            if not old or old["signal"] < c["signal"]:
                nets[c["ssid"]] = c

    for line in out.splitlines():
        s = line.strip()
        if line.startswith("BSS "):
            keep(cur)
            cur = {"ssid": "", "signal": -100.0, "secure": False}
        elif cur is None:
            continue
        elif s.startswith("signal:"):
            try:
                cur["signal"] = float(s.split()[1])
            except (IndexError, ValueError):
                pass
        elif s.startswith("SSID:"):
            cur["ssid"] = iw_ssid(s[5:].strip())
        elif s.startswith(("RSN:", "WPA:")) or (s.startswith("capability:") and "Privacy" in s):
            cur["secure"] = True
    keep(cur)
    return sorted(nets.values(), key=lambda x: -x["signal"])[:12]


def wpa_conf(ssid: str, psk: str) -> str:
    """إعداد wpa_supplicant: يعمل مع WPA2 و WPA3 والشبكات المفتوحة."""
    q = lambda v: f'"{v}"'
    name = q(ssid) if '"' not in ssid and "\\" not in ssid else ssid.encode().hex()
    net = f"network={{\n    ssid={name}\n    scan_ssid=1\n"
    if re.fullmatch(r"[0-9a-fA-F]{64}", psk or ""):  # مفتاح جاهز بدل كلمة المرور
        net += f"    psk={psk}\n"
    elif psk:
        net += f"    psk={q(psk)}\n    key_mgmt=WPA-PSK WPA-PSK-SHA256 SAE\n    ieee80211w=1\n"
    else:
        net += "    key_mgmt=NONE\n"
    return "ctrl_interface=/run/wpa_supplicant\nupdate_config=0\n\n" + net + "}\n"


def wifi_stop(wi: str):
    if WPA_PID.exists():
        try:
            os.kill(int(WPA_PID.read_text().strip()), 15)
        except (ValueError, OSError):
            pass
        WPA_PID.unlink(missing_ok=True)
        time.sleep(0.5)
    sh(["dhcpcd", "-x", wi])
    sh(["ip", "addr", "flush", "dev", wi])


def wifi_connect(ssid: str, psk: str) -> dict:
    """يتصل بالوايفاي الآن (في نظام الفلاشة) ويحفظ الشبكة ليُنقل إعدادها إلى النظام المثبّت."""
    if FAKE:
        time.sleep(2)
        if psk == "wrong-pass":
            return {"error": "auth"}
        wifi.update(iface="wlan0", ssid=ssid, psk=psk)
        fake_net["wifi_ip"] = "192.168.1.77"
        return {"ok": True, "ip": fake_net["wifi_ip"]}
    wi = wifi_iface()
    if not wi:
        return {"error": "noadapter"}
    log(f"wifi connect {wi} {ssid!r}")
    wifi_stop(wi)
    conf = Path("/") / WIFI_CONF
    conf.parent.mkdir(parents=True, exist_ok=True)
    conf.write_text(wpa_conf(ssid, psk))
    os.chmod(conf, 0o600)
    rfkill_unblock()
    sh(["ip", "link", "set", wi, "up"])
    r = sh(["wpa_supplicant", "-B", "-i", wi, "-c", str(conf), "-P", str(WPA_PID)])
    if r.returncode != 0:
        log("wpa_supplicant: " + (r.stderr or r.stdout)[-300:])
        return {"error": "driver"}
    # 1) الانضمام للشبكة (كلمة المرور)
    for _ in range(25):
        st = sh(["wpa_cli", "-i", wi, "status"]).stdout
        if "wpa_state=COMPLETED" in st:
            break
        time.sleep(1)
    else:
        log("wifi: not associated\n" + sh(["wpa_cli", "-i", wi, "status"]).stdout)
        wifi_stop(wi)
        return {"error": "auth"}
    # 2) أخذ عنوان من الراوتر
    sh(["dhcpcd", "-4", "-b", wi])
    for _ in range(30):
        ip = next((ipv4(l) for l in links() if l.get("ifname") == wi), None)
        if ip:
            wifi.update(iface=wi, ssid=ssid, psk=psk)
            log(f"wifi ok {ip}")
            return {"ok": True, "ip": ip}
        time.sleep(1)
    wifi_stop(wi)
    return {"error": "dhcp"}


def wifi_forget():
    if FAKE:
        fake_net["wifi_ip"] = None
    elif wifi.get("iface"):
        wifi_stop(wifi["iface"])
    wifi.clear()


def write_target_net():
    """شبكة النظام المثبّت: كل منافذ الكابل تأخذ عنوانها من الراوتر، والوايفاي المختار يتصل وحده عند الإقلاع."""
    wired = [l["ifname"] for l in links() if is_wired(l.get("ifname", "")) and l.get("link_type") == "ether"]
    net = "source /etc/network/interfaces.d/*\n\nauto lo\niface lo inet loopback\n"
    for n in wired:
        net += f"\nallow-hotplug {n}\niface {n} inet dhcp\n"
    (TARGET / "etc/network/interfaces.d").mkdir(parents=True, exist_ok=True)
    (TARGET / "etc/network/interfaces").write_text(net)
    # عند فصل الكابل لا يحاول النظام الإرسال عبره (فيعمل الوايفاي وحده)
    (TARGET / SYSCTL_NET).parent.mkdir(parents=True, exist_ok=True)
    (TARGET / SYSCTL_NET).write_text("net.ipv4.conf.all.ignore_routes_with_linkdown = 1\n"
                                     "net.ipv4.conf.default.ignore_routes_with_linkdown = 1\n"
                                     "net.ipv6.conf.all.ignore_routes_with_linkdown = 1\n")
    if wifi.get("ssid"):
        wi = wifi["iface"]
        conf = TARGET / WIFI_CONF
        conf.parent.mkdir(parents=True, exist_ok=True)
        conf.write_text(wpa_conf(wifi["ssid"], wifi.get("psk", "")))
        os.chmod(conf, 0o600)
        (TARGET / WIFI_FILE).write_text(f"allow-hotplug {wi}\niface {wi} inet dhcp\n    wpa-conf /{WIFI_CONF}\n")
    # هوية الجهاز عند الراوتر: نفسها بعد إعادة التشغيل، فيبقى العنوان نفسه غالباً
    lease = Path("/var/lib/dhcpcd")
    if lease.is_dir():
        run(["cp", "-a", f"{lease}/.", str(TARGET / "var/lib/dhcpcd")], check=False)


# ----------------------------------------------------------------------------- التثبيت
def explain(e: Exception) -> tuple[str, str | None]:
    s = str(e)
    if re.search(r"I/O error|Input/output|READ DMA|ABRT", s, re.I):
        return s, "disk"
    if "No space" in s:
        return s, "space"
    return s, None


def install(cfg):
    try:
        set_state(stage="installing", started=time.time(), error=None, hint=None)
        do_install(cfg)
        set_state(stage="done", step=len(STEPS), percent=100, detail="", eta_min=0)
        log("done")
    except Exception as e:  # noqa: BLE001
        msg, hint = explain(e)
        log("ERROR " + msg)
        set_state(stage="error", error=msg, hint=getattr(e, "hint", None) or hint)
        if not FAKE:
            subprocess.run(["sh", "-c", "umount -R /target 2>/dev/null; mdadm --stop /dev/md0 2>/dev/null"], capture_output=True)


def do_install(cfg):
    disk = cfg["disk"]
    disk2 = cfg.get("disk2") if cfg.get("raid") else None
    targets = [disk] + ([disk2] if disk2 else [])
    efi = Path("/sys/firmware/efi").exists()

    # 3 — تجهيز القرص
    progress("prepare", 0, "مسح القرص")
    run(["sh", "-c", "umount -R /target 2>/dev/null; swapoff -a; mdadm --stop --scan 2>/dev/null; true"], check=False)
    for d in targets:
        run(["wipefs", "-a", d])
        run(["sgdisk", "--zap-all", d], check=False)
        run(["parted", "-s", d, "mklabel", "gpt",
             "mkpart", "BIOS", "1MiB", "3MiB", "set", "1", "bios_grub", "on",
             "mkpart", "EFI", "fat32", "3MiB", "515MiB", "set", "2", "esp", "on",
             "mkpart", "root", "ext4", "515MiB", "100%"])
    run(["partprobe"] + targets, check=False)
    run(["udevadm", "settle"], check=False)
    time.sleep(1)
    progress("prepare", 0.4, "تهيئة الأقسام")
    for d in targets:
        run(["mkfs.vfat", "-F", "32", "-n", "EFI", part(d, 2)])
    if disk2:
        run(["mdadm", "--create", "/dev/md0", "--level=1", "--raid-devices=2", "--metadata=1.2", "--run",
             part(disk, 3), part(disk2, 3)], input="y\n")
        root_dev = "/dev/md0"
    else:
        root_dev = part(disk, 3)
    run(["mkfs.ext4", "-F", "-L", "hsef-root", root_dev])
    TARGET.mkdir(exist_ok=True)
    run(["mount", root_dev, str(TARGET)])
    (TARGET / "boot/efi").mkdir(parents=True, exist_ok=True)
    run(["mount", part(disk, 2), str(TARGET / "boot/efi")])

    # 4 — نسخ النظام
    progress("copy", 0, "نسخ النظام")
    if FAKE:
        for i in range(1, 21):
            time.sleep(0.15)
            progress("copy", i / 20, f"copying ({i * 5}%)")
    else:
        p = subprocess.Popen(["rsync", "-aHAXx", "--numeric-ids", "--info=progress2", "--no-inc-recursive",
                              f"{SOURCE}/", f"{TARGET}/"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
        buf = ""
        while True:
            ch = p.stdout.read(1)
            if not ch:
                break
            if ch in "\r\n":
                m = re.search(r"(\d+)%", buf)
                if m:
                    progress("copy", int(m.group(1)) / 100, f"{m.group(1)}%")
                buf = ""
            else:
                buf += ch
        p.wait()
        if p.returncode not in (0, 24):
            raise Fail("rsync: " + p.stderr.read()[-300:])

    # 5 — إعداد HOME ANAB
    progress("configure", 0, "إعداد النظام")
    uuid = lambda dev: run(["blkid", "-s", "UUID", "-o", "value", dev]).stdout.strip() or "FAKE"
    if not FAKE:
        (TARGET / "etc/fstab").write_text(
            "# HOME ANAB\n"
            f"UUID={uuid(root_dev)}  /          ext4  errors=remount-ro  0 1\n"
            f"UUID={uuid(part(disk, 2))}  /boot/efi  vfat  umask=0077        0 1\n")
        (TARGET / "etc/hostname").write_text("hsef\n")
        write_target_net()
        (TARGET / "etc/machine-id").write_text("")
        Path(TARGET / "var/lib/dbus/machine-id").unlink(missing_ok=True)
        # مفتاح سرّي جديد لكل جهاز
        conf = TARGET / "etc/homenas/config.json"
        if conf.exists():
            c = json.loads(conf.read_text())
            c["secret_key"] = secrets.token_hex(32)
            conf.write_text(json.dumps(c, indent=2))
        (TARGET / "etc/homenas/install.json").write_text(json.dumps({"lang": cfg.get("lang", "ar"), "version": VERSION,
                                                                     "installed": time.strftime("%Y-%m-%d %H:%M")}))
        if disk2:
            scan = run(["mdadm", "--detail", "--scan"]).stdout
            mc = TARGET / "etc/mdadm/mdadm.conf"
            mc.parent.mkdir(parents=True, exist_ok=True)
            mc.write_text((mc.read_text() if mc.exists() else "") + scan)
    for m in ("dev", "proc", "sys", "run"):
        run(["mount", "--rbind", f"/{m}", str(TARGET / m)])
        run(["mount", "--make-rslave", str(TARGET / m)], check=False)
    if efi:
        run(["mount", "-t", "efivarfs", "efivarfs", str(TARGET / "sys/firmware/efi/efivars")], check=False)
    progress("configure", 0.4, "إزالة أدوات الفلاشة")
    ch = ["chroot", str(TARGET)]
    run(ch + ["sh", "-c", "dpkg --purge live-boot live-boot-initramfs-tools live-tools 2>/dev/null; rm -f /etc/systemd/system/multi-user.target.wants/hsef-installer.service; true"], check=False)
    progress("configure", 0.6, "تجهيز الإقلاع")
    run(ch + ["update-initramfs", "-u", "-k", "all"])

    # 6 — محمّل الإقلاع (يعمل بنظامي UEFI و BIOS)
    progress("boot", 0, "تثبيت محمّل الإقلاع")
    if efi:
        r = run(ch + ["grub-install", "--target=x86_64-efi", "--efi-directory=/boot/efi", "--bootloader-id=debian",
                      "--uefi-secure-boot", "--force-extra-removable", "--recheck"], check=False)
        if r.returncode != 0:  # بعض الأجهزة ترفض الكتابة في ذاكرة UEFI: نكتفي بالمسار الاحتياطي
            run(ch + ["grub-install", "--target=x86_64-efi", "--efi-directory=/boot/efi", "--bootloader-id=debian",
                      "--uefi-secure-boot", "--removable", "--no-nvram"])
    else:
        run(ch + ["grub-install", "--target=x86_64-efi", "--efi-directory=/boot/efi", "--bootloader-id=debian",
                  "--uefi-secure-boot", "--removable", "--no-nvram"], check=False)
    for d in targets:
        run(ch + ["grub-install", "--target=i386-pc", "--recheck", d], check=False)
    progress("boot", 0.6, "تحديث قائمة الإقلاع")
    run(ch + ["update-grub"])
    if disk2:  # نسخة من قسم EFI على القرص الثاني
        run(["sh", "-c", f"mkdir -p /mnt/efi2 && mount {part(disk2, 2)} /mnt/efi2 && cp -a {TARGET}/boot/efi/. /mnt/efi2/ && umount /mnt/efi2"], check=False)
    progress("boot", 0.9, "إنهاء")
    run(["sync"])
    run(["umount", "-R", str(TARGET)], check=False)


# ----------------------------------------------------------------------------- خادم الواجهة
class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, data, ctype="application/json"):
        body = data if isinstance(data, bytes) else json.dumps(data, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/api/state":
            with lock:
                return self.send(200, dict(state))
        if path == "/api/disks":
            return self.send(200, {"disks": disks(), "efi": Path("/sys/firmware/efi").exists()})
        if path == "/api/net":
            return self.send(200, net_info())
        rel = "index.html" if path in ("/", "") else path.lstrip("/")
        f = (UI / rel).resolve()
        if not str(f).startswith(str(UI.resolve())) or not f.is_file():
            return self.send(404, {"error": "not found"})
        ctype = {".html": "text/html; charset=utf-8", ".js": "text/javascript", ".css": "text/css", ".png": "image/png",
                 ".svg": "image/svg+xml", ".woff2": "font/woff2"}.get(f.suffix, "application/octet-stream")
        return self.send(200, f.read_bytes(), ctype)

    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        try:
            d = json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            d = {}
        if self.path == "/api/lang":
            set_state(lang=d.get("lang") if d.get("lang") in ("ar", "en", "fr") else "ar")
            return self.send(200, {"ok": True})
        if self.path == "/api/install":
            if state["stage"] == "installing":
                return self.send(409, {"error": "busy"})
            names = {x["path"] for x in disks()}
            if d.get("disk") not in names or (d.get("raid") and (d.get("disk2") not in names or d.get("disk2") == d.get("disk"))):
                return self.send(400, {"error": "bad disk"})
            cfg = {"disk": d["disk"], "disk2": d.get("disk2"), "raid": bool(d.get("raid")), "lang": state["lang"]}
            log("install " + json.dumps(cfg))
            threading.Thread(target=install, args=(cfg,), daemon=True).start()
            return self.send(200, {"ok": True})
        if self.path == "/api/wifi/scan":
            return self.send(200, {"networks": wifi_scan(), "net": net_info()})
        if self.path == "/api/wifi/connect":
            ssid, psk = str(d.get("ssid") or ""), str(d.get("psk") or "")
            if not ssid or len(ssid.encode()) > 32 or re.search(r"[\r\n\x00]", ssid):
                return self.send(400, {"error": "ssid"})
            if psk and (len(psk) < 8 or len(psk) > 64 or re.search(r"[\r\n\x00]", psk)):
                return self.send(400, {"error": "psk"})
            if state["stage"] == "installing":
                return self.send(409, {"error": "busy"})
            with wifi_lock:
                r = wifi_connect(ssid, psk)
            return self.send(200, {**r, "net": net_info()})
        if self.path == "/api/wifi/forget":
            wifi_forget()
            return self.send(200, {"ok": True, "net": net_info()})
        if self.path in ("/api/reboot", "/api/poweroff"):
            self.send(200, {"ok": True})
            if not FAKE:
                subprocess.Popen(["sh", "-c", f"sleep 1; systemctl {'reboot' if self.path.endswith('reboot') else 'poweroff'}"])
            return None
        if self.path == "/api/retry":
            set_state(stage="welcome", step=STEPS.index("disk"), percent=0, error=None, hint=None, detail="")
            return self.send(200, {"ok": True})
        return self.send(404, {"error": "not found"})


