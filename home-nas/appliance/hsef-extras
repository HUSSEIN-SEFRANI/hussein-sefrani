def bt_ctl(commands, timeout=40) -> str:
    """يرسل أوامر إلى bluetoothctl مع انتظار بعد كل أمر."""
    p = subprocess.Popen(["bluetoothctl"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    try:
        for cmd, wait in commands:
            p.stdin.write(cmd + "\n")
            p.stdin.flush()
            _time.sleep(wait)
        p.stdin.write("quit\n")
        p.stdin.flush()
        out, _ = p.communicate(timeout=timeout)
    except Exception:
        p.kill()
        out = ""
    return _re.sub(r"\x1b\[[0-9;]*[A-Za-z]|\x01|\x02", "", out or "")


