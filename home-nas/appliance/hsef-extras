MAC_RE = _re.compile(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$")


def valid_ip(s: str) -> bool:
    m = IP_RE.match(s or "")
    return bool(m) and all(0 <= int(x) <= 255 for x in m.groups())


def jrun(cmd) -> list:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    try:
        return json.loads(r.stdout or "[]")
    except ValueError:
        return []


def wired_iface() -> str | None:
    for l in jrun(["ip", "-j", "link"]):
        n = l.get("ifname", "")
        if n != "lo" and not n.startswith(("wl", "docker", "br-", "veth", "tailscale")) and l.get("link_type") == "ether":
            return n
    return None


def wifi_iface() -> str | None:
    for l in jrun(["ip", "-j", "link"]):
        n = l.get("ifname", "")
        if n.startswith("wl"):
            return n
    return None


