def tv_session(url: str):
    """يعمل داخل جلسة الشاشة (مستخدم hseftv): يضبط الدقة المحفوظة ثم يشغّل المتصفح."""
    mode = TV_MODE.read_text().strip() if TV_MODE.exists() else ""
    if mode and shutil.which("wlr-randr"):
        try:
            outs = json.loads(subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=10).stdout or "[]")
            name = next((o["name"] for o in outs if o.get("enabled", True)), None)
            if name:
                subprocess.run(["wlr-randr", "--output", name, "--mode", mode], capture_output=True, timeout=10)
        except Exception:
            pass
    if not _re.match(r"^http://127\.0\.0\.1(:\d+)?/tv$", url):
        url = "http://127.0.0.1/tv"
    try:
        if "hsef_installer" in Path("/proc/cmdline").read_text().split():
            url = "http://127.0.0.1:9999/"
    except OSError:
        pass
    if shutil.which("pactl") and os.fork() == 0:
        try:
            os.setsid()
            audio_watch()
        finally:
            os._exit(0)
    os.execv("/usr/bin/chromium", ["chromium", *CHROMIUM_FLAGS.split(), url])


