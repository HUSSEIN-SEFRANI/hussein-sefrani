                          "wifi": {"iface": "wlan0", "installed": True, "ssid": None}}))
        return
    ifc = wired_iface()
    addr = next((a for l in jrun(["ip", "-j", "addr"]) if l.get("ifname") == ifc for a in l.get("addr_info", []) if a.get("family") == "inet"), {})
    gw = next((r.get("gateway") for r in jrun(["ip", "-j", "route", "show", "default"]) if r.get("gateway")), None)
    dns = [l.split()[1] for l in Path("/etc/resolv.conf").read_text().splitlines() if l.startswith("nameserver")] if Path("/etc/resolv.conf").exists() else []
    txt = IFACES.read_text() if IFACES.exists() else ""
    mode = "static" if ifc and _re.search(rf"iface\s+{_re.escape(ifc)}\s+inet\s+static", txt) else "dhcp"
    wi = wifi_iface()
    wifi = {"iface": wi, "installed": bool(shutil.which("wpa_supplicant")), "ssid": None}
    if wi and WIFI_FILE.exists():
        txt = WIFI_CONF.read_text() if WIFI_CONF.exists() else WIFI_FILE.read_text()
        m = _re.search(r'ssid="(.*?)"', txt) or _re.search(r'wpa-ssid\s+"?(.*?)"?\s*$', txt, _re.M)
        wifi["ssid"] = m.group(1) if m else None
        wifi["ip"] = next((a.get("local") for l in jrun(["ip", "-j", "addr"]) if l.get("ifname") == wi for a in l.get("addr_info", []) if a.get("family") == "inet"), None)
    print(json.dumps({"iface": ifc, "mode": mode, "ip": addr.get("local"), "prefix": addr.get("prefixlen"), "gateway": gw, "dns": dns,
                      "pending": unit_active("hsef-net-revert.timer"), "supported": IFACES.exists() and bool(ifc), "wifi": wifi}))


def iface_stanza(ifc, static=None) -> str:
    if not static:
        return f"allow-hotplug {ifc}\niface {ifc} inet dhcp\n"
    return (f"allow-hotplug {ifc}\niface {ifc} inet static\n    address {static['ip']}/{static['prefix']}\n"
            f"    gateway {static['gateway']}\n")


def rewrite_ifaces(ifc, static=None):
    txt = IFACES.read_text()
    # احذف كتلة الواجهة القديمة (allow-hotplug/auto + iface + أسطرها المزاحة)
    out, skip = [], False
    for line in txt.splitlines():
        s = line.strip()
        if _re.match(rf"^(allow-hotplug|auto)\s+{_re.escape(ifc)}\s*$", s):
            continue
        if _re.match(rf"^iface\s+{_re.escape(ifc)}\s+inet6?\s", s):
            skip = True
            continue
        if skip and (line.startswith((" ", "\t")) or not s):
            if not s:
                skip = False
            continue
        skip = False
        out.append(line)
    IFACES.write_text("\n".join(out).rstrip() + "\n\n" + iface_stanza(ifc, static))


def net_set(mode: str, ip="", prefix="24", gateway="", dns=""):
    """يغيّر العنوان مع شبكة أمان: إن لم يُؤكَّد من العنوان الجديد خلال 3 دقائق يعود الإعداد القديم."""
    ifc = wired_iface()
    if not ifc or not IFACES.exists():
        die("network configuration not supported on this machine")
    static = None
    if mode == "static":
        if not (valid_ip(ip) and valid_ip(gateway) and str(prefix).isdigit() and 8 <= int(prefix) <= 30):
            die("invalid address")
        dns_list = [d for d in dns.split(",") if valid_ip(d.strip())] or [gateway]
        static = {"ip": ip, "prefix": int(prefix), "gateway": gateway}
    if FAKE:
        return
    if not IFACES_BAK.exists():
        shutil.copyfile(IFACES, IFACES_BAK)
        if Path("/etc/resolv.conf").exists() and not Path("/etc/resolv.conf").is_symlink():
            shutil.copyfile("/etc/resolv.conf", RESOLV_BAK)
    rewrite_ifaces(ifc, static)
    if static:
        Path("/etc/resolv.conf").write_text("".join(f"nameserver {d.strip()}\n" for d in dns_list))
    subprocess.run(["systemctl", "stop", "hsef-net-revert.timer"], capture_output=True)
    run(["systemd-run", "--unit=hsef-net-revert", "--on-active=180", "--collect", "/usr/local/sbin/hsef-extras", "net-revert"])
    # إعادة تشغيل الواجهة في الخلفية (الاتصال الحالي سينقطع)
    run(["systemd-run", "--unit=hsef-net-apply", "--collect", "/bin/sh", "-c", f"sleep 2; ifdown --force {ifc}; ifup {ifc}; systemctl restart avahi-daemon"])


def net_revert():
    ifc = wired_iface()
    if IFACES_BAK.exists():
        shutil.copyfile(IFACES_BAK, IFACES)
        IFACES_BAK.unlink()
    if RESOLV_BAK.exists():
        shutil.copyfile(RESOLV_BAK, "/etc/resolv.conf")
        RESOLV_BAK.unlink()
    if ifc:
        subprocess.run(["sh", "-c", f"ifdown --force {ifc}; ifup {ifc}; systemctl restart avahi-daemon"], capture_output=True)


