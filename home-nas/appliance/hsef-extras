def tv_pactl(*args, check=False):
    """pactl بصلاحية مستخدم الشاشة (الصوت يعمل داخل جلسته)."""
    import pwd
    if not shutil.which("pactl"):
        apt_install("pulseaudio-utils")
    try:
        uid = pwd.getpwnam(TV_USER).pw_uid
    except KeyError:
        die("TV screen is not installed")
    if not Path(f"/run/user/{uid}").exists():
        die("TV screen is not running (start it first)")
    r = subprocess.run(["runuser", "-u", TV_USER, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}", "pactl", *args],
                       capture_output=True, text=True, timeout=30)
    if check and r.returncode != 0:
        die((r.stderr or r.stdout).strip()[-300:] or "pactl failed")
    return r


TV_AUDIO_CHOICE = TV_HOME / "audio-choice.json"


def audio_pick(pactl) -> dict:
    """يختار مخرج الصوت: اختيار المدير إن وُجد، وإلا HDMI الموصول فعلاً (التلفاز). pactl(*args) -> stdout"""
    cards = json.loads(pactl("-f", "json", "list", "cards") or "[]")
    choice = None
    try:
        choice = json.loads(TV_AUDIO_CHOICE.read_text())
    except (OSError, ValueError):
        pass
    target = None
    if choice:
        c = next((c for c in cards if c.get("name") == choice.get("card")), None)
        if c and (c.get("profiles") or {}).get(choice.get("profile"), {}).get("available", True) is not False:
            target = (c, choice["profile"])
    if not target:
        best = None
        for c in cards:
            profs = c.get("profiles") or {}
            for pname, port in (c.get("ports") or {}).items():
                is_hdmi = str(port.get("type", "")).upper() in ("HDMI", "DISPLAYPORT") or pname.startswith("hdmi-output")
                if not is_hdmi or port.get("availability") != "available":
                    continue
                for prof in port.get("profiles") or []:
                    if not prof.startswith("output:hdmi") or profs.get(prof, {}).get("available") is False:
                        continue
                    rank = (0 if prof.startswith("output:hdmi-stereo") and "+input" not in prof else 1, -int(profs.get(prof, {}).get("priority") or 0))
                    if best is None or rank < best[0]:
                        best = (rank, c, prof)
        if best:
            target = (best[1], best[2])
    if not target:
        return {"changed": False, "output": None}
    card, prof = target
    changed = False
    if card.get("active_profile") != prof:
        pactl("set-card-profile", card["name"], prof)
        changed = True
    sinks = json.loads(pactl("-f", "json", "list", "sinks") or "[]")
    mine = [x for x in sinks if x.get("card") == card.get("index")]
    if mine:
        name = mine[0]["name"]
        if pactl("get-default-sink").strip() != name:
            pactl("set-default-sink", name)
            changed = True
        pactl("set-sink-mute", name, "0")
    return {"changed": changed, "output": (card.get("profiles") or {}).get(prof, {}).get("description") or prof}


def audio_watch():
    """يعمل في الخلفية داخل جلسة الشاشة: يختار مخرج التلفاز عند البدء، وعند تشغيل التلفاز لاحقاً."""
    def pactl(*args):
        r = subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=15)
        return r.stdout if r.returncode == 0 else ""
    first, tries = True, 0
    while True:
        try:
            if pactl("info"):
                r = audio_pick(pactl)
                if first and r.get("output"):
                    sink = pactl("get-default-sink").strip()
                    if sink:
                        pactl("set-sink-volume", sink, "100%")
                    first = False
        except Exception:
            pass
        tries += 1
        _time.sleep(5 if tries < 24 else 30)


def tv_audio_status():
    if FAKE:
        print(json.dumps({"outputs": [{"card": "c0", "profile": "output:hdmi-stereo", "name": "HDMI (التلفاز)", "active": True, "plugged": True},
                                      {"card": "c0", "profile": "output:analog-stereo", "name": "Analog", "plugged": False}],
                          "volume": 100, "muted": False, "auto": True, "sink": "fake"}))
        return
    cards = json.loads(tv_pactl("-f", "json", "list", "cards", check=True).stdout or "[]")
    outs = []
    for c in cards:
        active = c.get("active_profile")
        ports = c.get("ports") or {}
        for name, prof in (c.get("profiles") or {}).items():
            if not name.startswith("output:") or prof.get("available") is False:
                continue
            plugged = any(name in (pt.get("profiles") or []) and pt.get("availability") == "available" for pt in ports.values())
            outs.append({"card": c["name"], "profile": name, "name": prof.get("description") or name, "active": name == active, "plugged": plugged})
    vol, muted = None, None
    sink = tv_pactl("get-default-sink").stdout.strip()
    if sink:
        v = tv_pactl("get-sink-volume", sink).stdout
        import re
        m = re.search(r"(\d+)%", v)
        vol = int(m.group(1)) if m else None
        muted = "yes" in tv_pactl("get-sink-mute", sink).stdout
    print(json.dumps({"outputs": outs, "volume": vol, "muted": muted, "sink": sink, "auto": not TV_AUDIO_CHOICE.exists()}))


def tv_audio_set(card: str, profile: str):
    """اختيار يدوي من المدير، أو profile=auto للعودة إلى الاختيار التلقائي (HDMI)."""
    if FAKE:
        return
    if profile == "auto":
        TV_AUDIO_CHOICE.unlink(missing_ok=True)
    else:
        TV_AUDIO_CHOICE.parent.mkdir(parents=True, exist_ok=True)
        TV_AUDIO_CHOICE.write_text(json.dumps({"card": card, "profile": profile}))
        os.chmod(TV_AUDIO_CHOICE, 0o644)
    r = audio_pick(lambda *a: tv_pactl(*a).stdout)
    if profile != "auto" and not r.get("output"):
        tv_pactl("set-card-profile", card, profile, check=True)
    sink = tv_pactl("get-default-sink").stdout.strip()
    if sink:
        tv_pactl("set-sink-mute", sink, "0")
        tv_pactl("set-sink-volume", sink, "100%")


def tv_audio_test():
    if FAKE:
        return
    import math
    import struct
    import wave
    f = Path("/tmp/hsef-tv-test.wav")
    with wave.open(str(f), "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(44100)
        frames = bytearray()
        for note, dur in ((523, .25), (659, .25), (784, .4)):
            for i in range(int(44100 * dur)):
                v = int(12000 * math.sin(2 * math.pi * note * i / 44100) * min(1, (int(44100 * dur) - i) / 2000))
                frames += struct.pack("<hh", v, v)
        w.writeframes(bytes(frames))
    os.chmod(f, 0o644)
    tv_pactl("upload-sample", str(f), "hsef-test")
    tv_pactl("play-sample", "hsef-test", check=True)


