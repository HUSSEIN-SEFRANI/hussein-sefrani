def tv_env():
    import pwd
    uid = pwd.getpwnam(TV_USER).pw_uid
    return uid, dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{uid}", WAYLAND_DISPLAY="wayland-0")


def tv_modes():
    if FAKE:
        print(json.dumps({"available": True, "current": "1920x1080", "saved": "", "modes": ["3840x2160", "1920x1080", "1280x720"]}))
        return
    saved = TV_MODE.read_text().strip() if TV_MODE.exists() else ""
    if not shutil.which("wlr-randr"):
        print(json.dumps({"available": False, "saved": saved}))
        return
    try:
        uid, env = tv_env()
        r = subprocess.run(["runuser", "-u", TV_USER, "--", "env", f"XDG_RUNTIME_DIR={env['XDG_RUNTIME_DIR']}", "WAYLAND_DISPLAY=wayland-0",
                            "wlr-randr", "--json"], capture_output=True, text=True, timeout=20)
        outs = json.loads(r.stdout or "[]")
    except Exception:
        outs = []
    modes, cur = [], None
    for o in outs:
        if not o.get("enabled", True):
            continue
        for m in o.get("modes", []):
            res = f"{m['width']}x{m['height']}"
            if res not in modes:
                modes.append(res)
            if m.get("current"):
                cur = res
        break
    print(json.dumps({"available": True, "current": cur, "saved": saved, "modes": modes}))


