BT_MAIN = Path("/etc/bluetooth/main.conf")
BT_WANT = {"General": {"JustWorksRepairing": "always", "FastConnectable": "true"}, "Policy": {"AutoEnable": "true"}}


def bt_conf() -> bool:
    """إعدادات تساعد يد بلايستيشن: إعادة الربط بدون حذف، واتصال أسرع عند ضغط زر PS. يرجع True إن تغيّر شيء."""
    if not BT_MAIN.exists():
        return False
    old = BT_MAIN.read_text()
    out, sec, done = [], None, set()

    def flush(section):
        for k, v in BT_WANT.get(section, {}).items():
            if (section, k) not in done:
                out.append(f"{k} = {v}")
                done.add((section, k))

    for line in old.splitlines():
        m = _re.match(r"^\s*\[(\w+)\]\s*$", line)
        if m:
            flush(sec)
            sec = m.group(1)
            out.append(line)
            continue
        km = _re.match(r"^\s*#?\s*([A-Za-z]+)\s*=", line)
        if sec in BT_WANT and km and km.group(1) in BT_WANT[sec]:
            k = km.group(1)
            if (sec, k) not in done:
                out.append(f"{k} = {BT_WANT[sec][k]}")
                done.add((sec, k))
            continue
        out.append(line)
    flush(sec)
    for section in BT_WANT:
        if any((section, k) not in done for k in BT_WANT[section]):
            out.append(f"\n[{section}]")
            flush(section)
    new = "\n".join(out).rstrip() + "\n"
    if new == old:
        return False
    BT_MAIN.write_text(new)
    return True


def bt_session(steps, timeout=75) -> str:
    """bluetoothctl تفاعلي. يجيب «yes» تلقائياً على أي سؤال يطرحه (تأكيد الربط، السماح لخدمة اليد)،
    لأن الإجابة بأمر آخر كانت تُفهم «لا» فترفض اليد وينطفئ ضوؤها.
    steps: [(أمر, أقصى انتظار بالثواني, نص يكفي ظهوره لإنهاء الانتظار أو None)]"""
    import threading
    p = subprocess.Popen(["bluetoothctl"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    out = []

    def send(cmd):
        try:
            p.stdin.write(cmd + "\n")
            p.stdin.flush()
        except (OSError, ValueError):
            pass

    def reader():
        line = ""
        while True:
            ch = p.stdout.read(1)
            if not ch:
                break
            line += ch
            if "(yes/no)" in line:
                out.append(line)
                line = ""
                send("yes")
            elif ch == "\n":
                out.append(line)
                line = ""

    threading.Thread(target=reader, daemon=True).start()
    deadline = _time.time() + timeout
    for cmd, wait, until in steps:
        mark = len(out)
        send(cmd)
        end = min(_time.time() + wait, deadline)
        while _time.time() < end:
            _time.sleep(0.3)
            if until and any(_re.search(until, l) for l in out[mark:]):
                _time.sleep(0.5)
                break
    send("quit")
    try:
        p.wait(timeout=10)
    except subprocess.TimeoutExpired:
        p.kill()
    text = "".join(out)
    return _re.sub(r"\x1b\[[0-9;]*[A-Za-z]|\x01|\x02|\r", "", text)


def bt_info(mac: str) -> dict:
    try:
        info = subprocess.run(["bluetoothctl", "info", mac], capture_output=True, text=True, timeout=20).stdout
    except subprocess.TimeoutExpired:
        info = ""
    get = lambda k: (_re.search(rf"^\s*{k}:\s*(.+)$", info, _re.M) or [None, ""])[1].strip()
    return {k.lower(): get(k) for k in ("Name", "Paired", "Bonded", "Trusted", "Connected", "Icon")}


def bt_pair(mac: str):
    if not MAC_RE.match(mac):
        die("invalid device")
    if FAKE:
        return
    if bt_conf():
        subprocess.run(["systemctl", "restart", "bluetooth"], capture_output=True, timeout=30)
        _time.sleep(3)
    known = bt_info(mac)
    steps = [("power on", 2, "succeeded|Changing power"), ("pairable on", 1, None),
             ("agent NoInputNoOutput", 1, None), ("default-agent", 1, None)]
    if known.get("paired") != "yes":
        # اليد يجب أن تكون ظاهرة الآن (Create + PS حتى يومض الضوء بسرعة)
        steps += [("scan on", 10, mac), ("scan off", 1, None),
                  # الثقة قبل الربط: اليد تفتح اتصالها فور الربط، فتُقبل مباشرة بدل أن تُرفض
                  (f"trust {mac}", 2, "succeeded"),
                  (f"pair {mac}", 25, r"Pairing successful|Failed to pair|AlreadyExists|not available")]
    else:
        steps += [(f"trust {mac}", 2, "succeeded")]
    steps += [(f"connect {mac}", 15, r"Connection successful|Failed to connect")]
    out = bt_session(steps)
    for _ in range(10):  # اليد قد تتصل بنفسها بعد لحظات
        st = bt_info(mac)
        if st.get("connected") == "yes":
            return
        _time.sleep(1)
    if st.get("paired") == "yes":
        die("paired but not connected: press the PS button on the controller")
    if "not available" in out:
        die("controller not found: hold Create + PS until the light blinks fast, then try again")
    die("pairing failed: " + " ".join(out.split()[-25:]))


