def bt_devices() -> list:
    out = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True, timeout=20).stdout
    devs = []
    for line in out.splitlines():
        m = _re.match(r"Device\s+([0-9A-F:]{17})\s+(.*)", line.strip())
        if not m:
            continue
        info = subprocess.run(["bluetoothctl", "info", m.group(1)], capture_output=True, text=True, timeout=20).stdout
        get = lambda k: (_re.search(rf"{k}:\s*(\S+)", info) or [None, ""])[1]
        devs.append({"mac": m.group(1), "name": m.group(2), "paired": get("Paired") == "yes", "connected": get("Connected") == "yes",
                     "icon": get("Icon")})
    return devs


