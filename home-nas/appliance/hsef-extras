        tv_audio_test()
    elif a == ["net-status"]:
        net_status()
    elif a == ["net-set", "dhcp"]:
        net_set("dhcp")
    elif len(a) == 6 and a[:2] == ["net-set", "static"]:
        net_set("static", a[2], a[3], a[4], a[5])
    elif a == ["net-confirm"]:
        net_confirm()
    elif a == ["net-revert"]:
        net_revert()
    elif a == ["wifi-install"]:
        wifi_install()
    elif a == ["wifi-scan"]:
        wifi_scan()
    elif len(a) == 2 and a[0] == "wifi-connect":
        wifi_connect(a[1])
    elif a == ["wifi-forget"]:
        wifi_forget()
    elif len(a) == 2 and a[0] == "time-set":
        time_set(a[1])
    elif a in (["offline", "on"], ["offline", "off"]):
        offline_set(a[1] == "on")
    elif a == ["sys-status"]:
        sys_status()
    elif a == ["bt-install"]:
        bt_install()
    elif a == ["bt-status"]:
        bt_status()
    elif a == ["bt-scan"]:
        bt_scan()
    elif len(a) == 2 and a[0] == "bt-pair":
        bt_pair(a[1])
    elif len(a) == 2 and a[0] == "bt-remove":
        bt_remove(a[1])
    elif a == ["tv-modes"]:
        tv_modes()
    elif len(a) in (1, 2) and a[0] == "tv-mode-set":
        tv_mode_set(a[1] if len(a) == 2 else "")
    elif a == ["iphone-attach"]:
        iphone_attach()
    elif a == ["iphone-detach"]:
        iphone_detach()
