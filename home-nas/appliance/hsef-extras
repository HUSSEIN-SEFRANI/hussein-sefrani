WIFI_CONF = Path("/etc/wpa_supplicant/hsef-wifi.conf")
SYSCTL_NET = Path("/etc/sysctl.d/90-hsef-net.conf")


def ensure_linkdown_sysctl():
    """عند فصل الكابل لا يحاول النظام الإرسال عبر المنفذ المفصول (فيعمل الوايفاي وحده)."""
    SYSCTL_NET.write_text("net.ipv4.conf.all.ignore_routes_with_linkdown = 1\n"
                          "net.ipv4.conf.default.ignore_routes_with_linkdown = 1\n"
                          "net.ipv6.conf.all.ignore_routes_with_linkdown = 1\n")
    subprocess.run(["sysctl", "-q", "-p", str(SYSCTL_NET)], capture_output=True)


