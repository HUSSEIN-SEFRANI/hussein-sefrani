def iface_stanza(ifc, static=None) -> str:
    if not static:
        return f"allow-hotplug {ifc}\niface {ifc} inet dhcp\n"
    return (f"allow-hotplug {ifc}\niface {ifc} inet static\n    address {static['ip']}/{static['prefix']}\n"
            f"    gateway {static['gateway']}\n")


def rewrite_ifaces(ifc, static=None):
    txt = IFACES.read_text()
    # احذف كتلة الواجهة القديمة (allow-hotplug/auto + iface + أسطرها المزاحة)
    out, skip = [], False
    for line in txt.splitlines():
        s = line.strip()
        if _re.match(rf"^(allow-hotplug|auto)\s+{_re.escape(ifc)}\s*$", s):
            continue
        if _re.match(rf"^iface\s+{_re.escape(ifc)}\s+inet6?\s", s):
            skip = True
            continue
        if skip and (line.startswith((" ", "\t")) or not s):
            if not s:
                skip = False
            continue
        skip = False
        out.append(line)
    IFACES.write_text("\n".join(out).rstrip() + "\n\n" + iface_stanza(ifc, static))


def net_set(mode: str, ip="", prefix="24", gateway="", dns=""):
    """يغيّر العنوان مع شبكة أمان: إن لم يُؤكَّد من العنوان الجديد خلال 3 دقائق يعود الإعداد القديم."""
    ifc = wired_iface()
    if not ifc or not IFACES.exists():
        die("network configuration not supported on this machine")
    static = None
    if mode == "static":
        if not (valid_ip(ip) and valid_ip(gateway) and str(prefix).isdigit() and 8 <= int(prefix) <= 30):
            die("invalid address")
        dns_list = [d for d in dns.split(",") if valid_ip(d.strip())] or [gateway]
        static = {"ip": ip, "prefix": int(prefix), "gateway": gateway}
    if FAKE:
        return
    if not IFACES_BAK.exists():
        shutil.copyfile(IFACES, IFACES_BAK)
        if Path("/etc/resolv.conf").exists() and not Path("/etc/resolv.conf").is_symlink():
            shutil.copyfile("/etc/resolv.conf", RESOLV_BAK)
    rewrite_ifaces(ifc, static)
    if static:
        Path("/etc/resolv.conf").write_text("".join(f"nameserver {d.strip()}\n" for d in dns_list))
    subprocess.run(["systemctl", "stop", "hsef-net-revert.timer"], capture_output=True)
    run(["systemd-run", "--unit=hsef-net-revert", "--on-active=180", "--collect", "/usr/local/sbin/hsef-extras", "net-revert"])
