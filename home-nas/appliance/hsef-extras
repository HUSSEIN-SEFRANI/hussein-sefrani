        media_list()
    elif len(a) == 2 and a[0] == "media-mount":
        media_mount(a[1])
    elif len(a) == 2 and a[0] == "media-eject":
        media_eject(a[1])
    elif a == ["tv-modes"]:
        tv_modes()
    elif len(a) in (1, 2) and a[0] == "tv-mode-set":
        tv_mode_set(a[1] if len(a) == 2 else "")
    elif a == ["iphone-attach"]:
        iphone_attach()
    elif a == ["iphone-detach"]:
        iphone_detach()
    elif a == ["iphone-install"]:
        iphone_install()
    elif a == ["net-fixups"]:
        net_fixups()
    elif a == ["iphone-rules"]:
        write_iphone_rules()
    elif a == ["tv-wait"]:
        import time
        import urllib.request
        wait_url = f"http://127.0.0.1:{hsef_port()}/tv"
        try:
            if "hsef_installer" in Path("/proc/cmdline").read_text().split():
                wait_url = "http://127.0.0.1:9999/"
        except OSError:
            pass
        for _ in range(90):  # انتظر حتى يجهز السيرفر قبل فتح المتصفح
            try:
                urllib.request.urlopen(wait_url, timeout=2)
                break
            except Exception as e:
                if getattr(e, "code", None):
                    break
                time.sleep(1)
    elif a == ["tv-write"]:
        if TV_UNIT.exists():
            tv_write()
    elif a == ["tv-write", "--create"]:
        tv_write()
    elif a == ["update-check"]:
        update_check()
    elif a == ["update-run"]:
        if FAKE:
            return
        background("hsef-update", "update-apply", log=UPD_LOG)
    elif a == ["update-apply"]:
        update_apply()
    elif len(a) == 2 and a[0] == "update-file":
        update_file(a[1])
    elif a == ["update-apply-file"]:
        try:
            install_pkg(UPD_PKG)
        finally:
            UPD_PKG.unlink(missing_ok=True)
    elif a == ["update-status"]:
        if FAKE:
            print(json.dumps({"running": False, "failed": False, "log": "", "current": current_version(), "previous": "1.5", "rolled_back": None}))
            return
        update_status()
    elif a == ["update-rollback"]:
        update_rollback()
    elif a == ["update-rollback-bg"]:  # من صفحة التحديث: في الخلفية حتى لا يتوقف مع إعادة تشغيل الخدمة
        if FAKE:
            return
        background("hsef-update", "update-rollback", log=UPD_LOG)
    elif a == ["update-verify"]:
        update_verify()
    else:
        die("usage: hsef-extras faces-deps | ts-* | tv-setup|tv-status|tv-enable|tv-disable|tv-restart | update-check|update-run|update-status")


if __name__ == "__main__":
    main()
