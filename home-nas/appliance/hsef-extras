def unit_active(name: str) -> bool:
    return subprocess.run(["systemctl", "is-active", "--quiet", name]).returncode == 0


def tv_write():
    port = hsef_port()
    url = f"http://127.0.0.1:{port}/tv"
    TV_HOME.mkdir(parents=True, exist_ok=True)
    if subprocess.run(["id", TV_USER], capture_output=True).returncode != 0:
        run(["useradd", "--system", "--home-dir", str(TV_HOME), "--shell", "/usr/sbin/nologin", TV_USER])
    for grp in ("video", "render", "input", "audio"):
        subprocess.run(["usermod", "-aG", grp, TV_USER], capture_output=True)
    run(["chown", "-R", f"{TV_USER}:{TV_USER}", str(TV_HOME)])
    Path("/etc/pam.d/hsef-tv").write_text(
        "auth     required pam_permit.so\naccount  required pam_permit.so\n"
        "session  required pam_unix.so\nsession  required pam_systemd.so\n")
    pol = Path("/etc/chromium/policies/managed")
    pol.mkdir(parents=True, exist_ok=True)
    (pol / "hsef-tv.json").write_text(json.dumps({
        "TranslateEnabled": False, "PasswordManagerEnabled": False, "AutofillAddressEnabled": False,
        "AutofillCreditCardEnabled": False, "DefaultBrowserSettingEnabled": False, "BrowserSignin": 0,
        "SyncDisabled": True, "MetricsReportingEnabled": False, "SpellcheckEnabled": False,
        "AutoplayAllowed": True, "HardwareAccelerationModeEnabled": True,
        "URLAllowlist": ["127.0.0.1", "localhost", "about:blank"], "URLBlocklist": ["*"],
        "DownloadRestrictions": 3, "DeveloperToolsAvailability": 2, "PrintingEnabled": False}, indent=1))
    TV_UNIT.write_text(f"""[Unit]
Description=HOME ANAB TV screen (shows /tv on the attached screen)
After=systemd-user-sessions.service plymouth-quit-wait.service homenas.service
Wants=homenas.service
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User={TV_USER}
PAMName=hsef-tv
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=+/usr/local/sbin/hsef-extras tv-wait
ExecStart=/usr/bin/cage -d -s -- /usr/local/sbin/hsef-extras tv-session {url}
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
""")
    run(["systemctl", "daemon-reload"], check=False)
    # الصوت داخل جلسة الشاشة: pipewire + wireplumber (بعض الأنظمة لا تفعّلها تلقائياً لمستخدم النظام)
    subprocess.run(["systemctl", "--global", "enable", "pipewire.socket", "pipewire-pulse.socket", "wireplumber.service"], capture_output=True)


def tv_installed() -> bool:
    return bool(shutil.which("cage") and shutil.which("chromium") and TV_UNIT.exists())


def tv_setup_run():
    """يعمل في الخلفية (systemd-run) حتى لا يتوقف إذا أُعيد تشغيل خدمة HOME ANAB."""
    apt_install(*TV_PKGS)
    tv_write()
    run(["systemctl", "set-default", "graphical.target"], check=False)
    run(["systemctl", "enable", "--now", "hsef-tv.service"], check=False)


def background(unit: str, *args, log: Path):
    log.parent.mkdir(parents=True, exist_ok=True)
    log.write_text("")
    if FAKE:
        return
    if unit_active(unit):
        die("already running")
    subprocess.run(["systemctl", "reset-failed", unit], capture_output=True)
    run(["systemd-run", f"--unit={unit}", "--collect", "--property=Type=exec",
         f"--property=StandardOutput=append:{log}", f"--property=StandardError=append:{log}",
         "/usr/local/sbin/hsef-extras", *args])


def tail(path: Path, n=3) -> str:
    try:
        return "\n".join(path.read_text(errors="replace").strip().splitlines()[-n:])
    except OSError:
        return ""


def tv_status():
    if FAKE:
        st = Path("/tmp/hsef-tv-fake")
        s = st.read_text().strip() if st.exists() else "none"
        print(json.dumps({"installed": s != "none", "enabled": s == "on", "active": s == "on", "installing": False, "error": None}))
        return
    installing = unit_active("hsef-tv-setup")
    failed = subprocess.run(["systemctl", "is-failed", "--quiet", "hsef-tv-setup"]).returncode == 0
    enabled = subprocess.run(["systemctl", "is-enabled", "--quiet", "hsef-tv.service"]).returncode == 0
    print(json.dumps({"installed": tv_installed(), "installing": installing, "enabled": enabled,
                      "active": unit_active("hsef-tv.service"), "error": tail(TV_LOG) if failed else None}))


def tv_cmd(action: str):
    if FAKE:
        Path("/tmp/hsef-tv-fake").write_text({"setup": "on", "enable": "on", "disable": "off", "restart": "on"}[action])
        return
    if action == "setup":
        background("hsef-tv-setup", "tv-setup-run", log=TV_LOG)
        return
    if not tv_installed():
        die("TV screen is not installed")
    if action == "enable":
        tv_write()
        run(["systemctl", "set-default", "graphical.target"], check=False)
        run(["systemctl", "enable", "--now", "hsef-tv.service"])
    elif action == "disable":
        run(["systemctl", "disable", "--now", "hsef-tv.service"], check=False)
        run(["systemctl", "start", "getty@tty1.service"], check=False)
    elif action == "restart":
        run(["systemctl", "restart", "hsef-tv.service"])


