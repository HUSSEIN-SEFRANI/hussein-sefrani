def wifi_connect(ssid: str):
    psk = sys.stdin.read().strip()
    if not ssid or len(ssid.encode()) > 32 or any(c in ssid for c in '"\n\r\\'):
        die("invalid network name")
    if psk and (len(psk) < 8 or len(psk) > 63 or any(c in psk for c in '"\n\r\\')):
        die("invalid password (8-63 characters)")
    if FAKE:
        print(json.dumps({"ok": True, "ip": "192.168.1.77"}))
        return
    wi = wifi_iface()
    if not wi:
        die("no wifi adapter found")
    ensure_linkdown_sysctl()
    WIFI_CONF.parent.mkdir(parents=True, exist_ok=True)
    net = f'network={{\n    ssid="{ssid}"\n    scan_ssid=1\n'
    net += f'    psk="{psk}"\n' if psk else "    key_mgmt=NONE\n"
    net += "}\n"
    WIFI_CONF.write_text("ctrl_interface=/run/wpa_supplicant\nupdate_config=0\n\n" + net)
    os.chmod(WIFI_CONF, 0o600)
    WIFI_FILE.parent.mkdir(parents=True, exist_ok=True)
    WIFI_FILE.write_text(f"allow-hotplug {wi}\niface {wi} inet dhcp\n    wpa-conf {WIFI_CONF}\n")
    subprocess.run(["sh", "-c", f"ifdown --force {wi} 2>/dev/null; ip link set {wi} up; ifup {wi}"], capture_output=True, timeout=90)
    for _ in range(25):  # تأكد أن الاتصال نجح فعلاً وأخذ عنواناً
        if iface_ipv4(wi):
            subprocess.run(["systemctl", "restart", "avahi-daemon"], capture_output=True)
            print(json.dumps({"ok": True, "ip": iface_ipv4(wi)}))
            return
        _time.sleep(1)
    die("not connected: check the password or move closer to the router")


