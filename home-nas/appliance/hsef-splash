#!/usr/bin/python3 -I
"""HOME ANAB: شعار السيرفر على الشاشة أثناء الإقلاع (البند 48).

يرسم الشعار ونقاطاً متحركة مباشرة على ‎/dev/fb0 (بلا حزم إضافية، فيعمل على الأجهزة الموجودة بعد التحديث)،
ويضع tty1 في وضع الرسوم حتى لا تكتب النواة نصاً فوقه. يتوقف عندما تفتح شاشة التلفاز (hsef-tv)،
أو بعد ‎MAX_S‎ ثانية، فيرجع الشاشة النصية (عنوان الجهاز) إن لم تكن هناك شاشة تلفاز.

    hsef-splash            (خدمة hsef-splash.service، مبكراً جداً في الإقلاع)
    hsef-splash --test DIR (للاختبار: يرسم في ملف بدل الشاشة)
"""
import fcntl
import os
import struct
import subprocess
import sys
import time
import zlib
from pathlib import Path

HERE = Path("/usr/local/share/hsef-splash")
BG = (0x14, 0x0A, 0x26)
DOT_ON, DOT_OFF = (0xC0, 0x84, 0xFC), (0x3B, 0x26, 0x5C)
MAX_S = 240
KDSETMODE, KD_TEXT, KD_GRAPHICS = 0x4B3A, 0, 1
VT_ACTIVATE, VT_WAITACTIVE = 0x5606, 0x5607


def png_rgb(path: Path):
    """قارئ PNG صغير (RGB/RGBA بعمق 8، بلا تشابك) يرجع (العرض، الارتفاع، صفوف RGB)."""
    data = path.read_bytes()
    assert data[:8] == b"\x89PNG\r\n\x1a\n"
    pos, idat, w = 8, b"", 0
    while pos < len(data):
        ln, typ = struct.unpack(">I4s", data[pos:pos + 8])
        chunk = data[pos + 8:pos + 8 + ln]
        if typ == b"IHDR":
            w, h, depth, ctype, _, _, inter = struct.unpack(">IIBBBBB", chunk)
            assert depth == 8 and ctype in (2, 6) and not inter
            bpp = 3 if ctype == 2 else 4
        elif typ == b"IDAT":
            idat += chunk
        pos += 12 + ln
    raw, stride, rows, prev = zlib.decompress(idat), w * bpp, [], bytearray(w * bpp)
    for y in range(h):
        f, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b, c = prev[i], prev[i - bpp] if i >= bpp else 0
            if f == 1: line[i] = (line[i] + a) & 255
            elif f == 2: line[i] = (line[i] + b) & 255
            elif f == 3: line[i] = (line[i] + ((a + b) >> 1)) & 255
            elif f == 4:
                p = a + b - c; pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        rows.append(bytes(line) if bpp == 3 else bytes(v for k, v in enumerate(line) if k % 4 != 3))
        prev = line
    return w, h, rows


class Screen:
    def __init__(self, dev="/dev/fb0", sysdir="/sys/class/graphics/fb0", size=None):
        self.dev = dev
        if size:
            self.w, self.h, self.bpp = size; self.stride = self.w * self.bpp // 8
        else:
            s = Path(sysdir)
            self.w, self.h = (int(v) for v in (s / "virtual_size").read_text().strip().split(","))
            self.bpp = int((s / "bits_per_pixel").read_text())
            st = s / "stride"
            self.stride = int(st.read_text()) if st.exists() else self.w * self.bpp // 8
        if self.bpp not in (16, 32):
            raise OSError(f"bpp {self.bpp}")

    def px(self, rgb_row: bytes) -> bytes:
        """صف RGB ← بايتات الشاشة (XRGB8888 أو RGB565)."""
        n = len(rgb_row) // 3
        if self.bpp == 32:
            out = bytearray(n * 4)
            out[0::4], out[1::4], out[2::4] = rgb_row[2::3], rgb_row[1::3], rgb_row[0::3]
            return bytes(out)
        out = bytearray(n * 2)
        for i in range(n):
            r, g, b = rgb_row[3 * i:3 * i + 3]
            v = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
            out[2 * i], out[2 * i + 1] = v & 255, v >> 8
        return bytes(out)

    def frame(self, logo):
        """الإطار كاملاً: خلفية + الشعار في الوسط. يرجع بايتات الإطار ومكان النقاط."""
        bg_row = self.px(bytes(BG) * self.w)
        pad = b"\0" * (self.stride - len(bg_row))
        lw, lh, rows = logo
        x0, y0 = (self.w - lw) // 2, (self.h - lh) // 2 - self.h // 20
        bpx = self.bpp // 8
        out = []
        for y in range(self.h):
            if y0 <= y < y0 + lh:
                r = self.px(rows[y - y0])
                out.append(bg_row[:x0 * bpx] + r + bg_row[(x0 + lw) * bpx:] + pad)
            else:
                out.append(bg_row + pad)
        d = max(10, self.h // 64)
        return b"".join(out), (self.w // 2, y0 + lh + d * 5, d)

    def write(self, buf: bytes, offset: int = 0):
        with open(self.dev, "r+b" if os.path.exists(self.dev) else "wb") as f:
            f.seek(offset); f.write(buf)

    def dots(self, where, step):
        cx, cy, d = where
        for i in range(3):
            rgb = bytes(DOT_ON if i == step % 3 else DOT_OFF) * d
            row = self.px(rgb)
            x = cx + (i - 1) * d * 3 - d // 2
            for y in range(cy, cy + d):
                self.write(row, y * self.stride + x * (self.bpp // 8))


_CACHE = {}


def pick_logo(w):
    best = None
    for p in sorted(HERE.glob("logo-*.png"), key=lambda p: int(p.stem.split("-")[1])):
        if int(p.stem.split("-")[1]) <= w * 0.6 or best is None:
            best = p
    if best not in _CACHE:
        _CACHE[best] = png_rgb(best)
    return _CACHE[best]


def active(unit) -> str:
    try:
        return subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


def enabled(unit) -> bool:
    try:
        return subprocess.run(["systemctl", "is-enabled", "--quiet", unit], timeout=5).returncode == 0
    except Exception:  # noqa: BLE001
        return False


def tty_mode(mode):
    try:
        fd = os.open("/dev/tty1", os.O_RDWR | os.O_NOCTTY)
        try:
            fcntl.ioctl(fd, KDSETMODE, mode)
        finally:
            os.close(fd)
    except OSError:
        pass


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--test":   # للاختبار: 1280×720 في ملف
        global HERE
        HERE = Path(sys.argv[2])
        sc = Screen(dev=str(HERE / "fb.raw"), size=(1280, 720, 32))
        buf, where = sc.frame(pick_logo(sc.w))
        sc.write(buf); sc.dots(where, 0)
        print(sc.w, sc.h, where); return
    if "hsef_installer" in Path("/proc/cmdline").read_text().split():
        return
    try:
        Path("/sys/class/graphics/fbcon/cursor_blink").write_text("0")
    except OSError:
        pass
    tv = enabled("hsef-tv.service")
    start, step, sig, grabbed = time.monotonic(), 0, None, False
    buf = where = sc = None
    while time.monotonic() - start < MAX_S:
        if tv and active("hsef-tv.service") == "active":
            return            # شاشة التلفاز (cage) أخذت الشاشة: لا نلمس tty1
        if not tv and active("homenas.service") == "active" and time.monotonic() - start > 4:
            break             # بلا تلفاز: ارجع إلى الشاشة النصية (عنوان الجهاز وكود الإعداد)
        try:
            st = os.stat("/dev/fb0")
            now = (st.st_ino, st.st_rdev, Path("/sys/class/graphics/fb0/virtual_size").read_text())
            if now != sig or step % 8 == 0:   # كرت الشاشة تغيّر (simpledrm ← i915/amdgpu) أو كتب أحد فوقنا
                if now != sig:
                    sc = Screen(); buf, where = sc.frame(pick_logo(sc.w)); sig = now
                if not grabbed:
                    tty_mode(KD_GRAPHICS); grabbed = True
                sc.write(buf)
            sc.dots(where, step)
        except (OSError, ValueError, AssertionError):
            sig = None        # لا شاشة بعد (أو لا تدعم): جرّب بعد قليل
        step += 1
        time.sleep(0.4)
    if grabbed:
        tty_mode(KD_TEXT)
        try:   # أعد رسم النص: انتقل إلى tty2 ثم ارجع
            fd = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
            for n in (2, 1):
                fcntl.ioctl(fd, VT_ACTIVATE, n); fcntl.ioctl(fd, VT_WAITACTIVE, n)
            os.close(fd)
        except OSError:
            pass


if __name__ == "__main__":
    main()
