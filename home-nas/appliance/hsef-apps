#!/usr/bin/env python3
"""hsef-apps — root helper for the HOME ANAB App Center (Docker containers).

Called by the web app (user 'homenas') through sudo:

    hsef-apps check                 is the container engine installed? (JSON)
    hsef-apps setup                 install the container engine (Docker)
    hsef-apps install ID            install / reconfigure app ID
    hsef-apps start|stop|restart|update ID
    hsef-apps remove ID [--purge]   remove app (--purge also deletes its settings/data)
    hsef-apps status                state of installed apps (JSON)
    hsef-apps logs ID               last lines of the app's own log

Security: apps come only from the root-owned catalog; the user may only choose a
port and folders. Folders must be under /srv, /mnt or /media (never HOME ANAB's
@system folder). Output of long operations goes to /var/lib/homenas/apps/ID.log.
"""
import json
import os
import pwd
import re
import shutil
import subprocess
import time
import sys
from pathlib import Path

TEST = os.environ.get("HSEF_APPS_TEST") == "1"
FAKE = os.environ.get("HSEF_APPS_FAKE") == "1"
CATALOG = Path(os.environ["HSEF_APPS_CATALOG"]) if TEST else Path("/opt/homenas/app/apps/catalog.json")
OPTIONS_DIR = Path(os.environ.get("HSEF_APPS_OPTIONS", "/etc/homenas/apps")) if TEST else Path("/etc/homenas/apps")
APPS_DIR = Path(os.environ.get("HSEF_APPS_DIR", "/srv/homenas/apps")) if TEST else Path("/srv/homenas/apps")
LOG_DIR = Path(os.environ.get("HSEF_APPS_LOGS", "/var/lib/homenas/apps")) if TEST else Path("/var/lib/homenas/apps")
CUSTOM_DIR = Path(os.environ.get("HSEF_APPS_CUSTOM", "/etc/homenas/apps-custom")) if TEST else Path("/etc/homenas/apps-custom")
SERVICE_USER = "homenas"
ALLOWED_ROOTS = ("/srv/", "/mnt/", "/media/")
FORBIDDEN = ("/@system",)
RESERVED_PORTS = {22, 53, 80, 443, 445, 139, 5353, 8200, 631}
ID_RE = re.compile(r"^[a-z0-9]{2,32}$")


def die(msg):
    print(f"hsef-apps: {msg}", file=sys.stderr)
    sys.exit(1)


def builtin_catalog() -> dict:
    return {a["id"]: a for a in json.loads(CATALOG.read_text())["apps"]}


def catalog() -> dict:
    """تطبيقات المركز + تطبيقات صاحب الجهاز (البند 42). التطبيق المرفوع لا يغطي تطبيقاً أصلياً بنفس الرقم."""
    apps = builtin_catalog()
    for f in sorted(CUSTOM_DIR.glob("*.json")) if CUSTOM_DIR.is_dir() else []:
        try:
            a = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(a, dict) and ID_RE.match(str(a.get("id", ""))) and a["id"] not in apps and f.stem == a["id"]:
            apps[a["id"]] = {**a, "custom": True}
    return apps


# ----------------------------------------------------------------------------- البند 42: تطبيقات من صنع صاحب الجهاز
CUSTOM_MAX = 64 * 1024
CUSTOM_PLACEHOLDERS = {"uid", "gid", "port", "tz", "data"}
# ما يعطي الحاوية سيطرة على الجهاز نفسه: ممنوع في التطبيقات المرفوعة
CUSTOM_FORBIDDEN = [
    (r"privileged\s*:\s*['\"]?true", "privileged"),
    (r"(network_mode|pid|ipc|uts|userns_mode)\s*:\s*['\"]?host", "host namespaces"),
    (r"docker\.sock", "docker.sock"),
    (r"^\s*(cap_add|devices|device_cgroup_rules|security_opt|cgroup_parent|sysctls)\s*:", "extra privileges"),
    (r"^\s*build\s*:", "build (use a ready image)"),
    (r"^\s*-\s*['\"]?(/|~|\.\.)", "host path (use {{data}} or {{folder:…}})"),
    (r"^\s*source\s*:\s*['\"]?(/|~|\.\.)", "host path (use {{data}} or {{folder:…}})"),
    (r"^\s*(env_file|configs|secrets|extends|include)\s*:", "files from the host"),
]


def _text(v, limit=300) -> dict:
    if isinstance(v, str):
        v = {"ar": v}
    if not isinstance(v, dict):
        return {}
    return {k: str(t)[:limit] for k, t in v.items() if k in ("ar", "en", "fr", "tr", "nl") and str(t).strip()}


def validate_custom(d) -> dict:
    """يرجع تعريف التطبيق نظيفاً، أو يتوقف برسالة السبب."""
    if not isinstance(d, dict):
        die("custom: app.json must be an object")
    app_id = str(d.get("id", "")).strip().lower()
    if not ID_RE.match(app_id):
        die("custom: id must be 2-32 lowercase letters/digits (a-z 0-9)")
    if app_id in builtin_catalog():
        die("custom: id already used by a built-in app")
    name = str(d.get("name", "")).strip()[:40]
    if not name:
        die("custom: name is required")
    try:
        port = int(d.get("port"))
    except (TypeError, ValueError):
        die("custom: port is required")
    if not (1024 <= port <= 65535) or port in RESERVED_PORTS:
        die("custom: port must be 1024-65535")
    folders = []
    for f in (d.get("folders") or [])[:5]:
        key = str((f or {}).get("key", ""))
        if not re.fullmatch(r"[a-z][a-z0-9_]{0,20}", key):
            die("custom: bad folder key")
        folders.append({"key": key, "write": bool(f.get("write")), "label": _text(f.get("label") or key, 60) or {"ar": key}})
    comp = d.get("compose")
    if not isinstance(comp, str) or "services:" not in comp or len(comp.encode()) > CUSTOM_MAX:
        die("custom: compose.yaml with services: is required (max 64 KB)")
    for pat, why in CUSTOM_FORBIDDEN:
        if re.search(pat, comp, re.I | re.M):
            die(f"custom: not allowed in compose: {why}")
    allowed = CUSTOM_PLACEHOLDERS | {f"folder:{f['key']}" for f in folders}
    for ph in re.findall(r"\{\{([^}]*)\}\}", comp):
        if ph not in allowed:
            die(f"custom: unknown placeholder {{{{{ph}}}}}")
    if "{{port}}" not in comp:
        die("custom: compose must publish {{port}}")
    try:
        ram = max(64, min(int(d.get("ram_mb") or 256), 65536))
    except (TypeError, ValueError):
        ram = 256
    path = str(d.get("path") or "/")
    if not re.fullmatch(r"/[A-Za-z0-9_./\-]{0,100}", path):
        path = "/"
    color = str(d.get("color") or "linear-gradient(135deg,#7c3aed,#db2777)")
    if not re.fullmatch(r"[a-z0-9#(),.% \-]{3,120}", color, re.I):
        color = "linear-gradient(135deg,#7c3aed,#db2777)"
    icon = str(d.get("icon") or "box")
    if not re.fullmatch(r"[a-z\-]{2,24}", icon):
        icon = "box"
    return {"id": app_id, "name": name, "category": "custom", "icon": icon, "color": color, "ram_mb": ram,
            "port": port, "path": path, "scheme": "https" if d.get("scheme") == "https" else "http",
            "summary": _text(d.get("summary") or name) or {"ar": name}, "notes": _text(d.get("notes"), 600),
            "folders": folders, "compose": comp, "custom": True}


def cmd_custom_add(src):
    """يقرأ ملف JSON كتبه الخادم، ويتحقق منه، ويحفظه في مجلد التطبيقات المرفوعة (root فقط يكتب فيه)."""
    p = Path(src)
    try:
        if p.stat().st_size > 2 * CUSTOM_MAX:
            die("custom: file too large")
        d = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        die("custom: cannot read app definition")
    app = validate_custom(d)
    old = CUSTOM_DIR / f"{app['id']}.json"
    if old.exists() and (APPS_DIR / app["id"] / "compose.yaml").exists():
        die("custom: app is installed; remove it first, then upload the new version")
    CUSTOM_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CUSTOM_DIR, 0o755)
    tmp = CUSTOM_DIR / f".{app['id']}.tmp"
    tmp.write_text(json.dumps(app, ensure_ascii=False, indent=1))
    os.chmod(tmp, 0o644)
    tmp.replace(old)
    print(json.dumps({"id": app["id"], "name": app["name"]}, ensure_ascii=False))


def cmd_custom_remove(app_id):
    if not ID_RE.match(app_id or ""):
        die("bad app id")
    f = CUSTOM_DIR / f"{app_id}.json"
    if not f.exists():
        die("custom: not an uploaded app")
    if (APPS_DIR / app_id / "compose.yaml").exists():
        die("custom: app is installed; remove it first")
    f.unlink()


def app_def(app_id):
    if not ID_RE.match(app_id or ""):
        die("bad app id")
    apps = catalog()
    if app_id not in apps:
        die("unknown app")
    return apps[app_id]


def log_path(app_id):
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    return LOG_DIR / f"{app_id}.log"


def run_logged(app_id, *cmd, append=True):
    """Run a command, streaming its output into the app's log file."""
    lp = log_path(app_id)
    with open(lp, "a" if append else "w") as log:
        log.write(f"$ {' '.join(cmd)}\n")
        log.flush()
        if FAKE:
            log.write("(test mode: command not executed)\n")
            return 0
        r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT)
        log.write(f"[exit {r.returncode}]\n")
    os.chmod(lp, 0o644)
    return r.returncode


def compose_cmd():
    if FAKE:
        return ["docker", "compose"]
    if shutil.which("docker") and subprocess.run(["docker", "compose", "version"], capture_output=True).returncode == 0:
        return ["docker", "compose"]
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    return None


def service_ids():
    try:
        pw = pwd.getpwnam(SERVICE_USER)
        return pw.pw_uid, pw.pw_gid
    except KeyError:
        return os.getuid(), os.getgid()


def timezone():
    try:
        return os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return "UTC"


def safe_folder(path) -> str:
    p = os.path.realpath(str(path))
    if not any((p + "/").startswith(r) for r in ALLOWED_ROOTS) or any(f in p for f in FORBIDDEN):
        die(f"folder not allowed: {path}")
    if not os.path.isdir(p):
        die(f"folder does not exist: {path}")
    if any(c in p for c in "\"\n\r$`"):
        die("bad characters in folder path")
    return p


def render(app, opts) -> str:
    uid, gid = service_ids()
    port = int(opts.get("port") or app["port"])
    if app.get("fixed_port"):
        port = app["port"]
    if not (1024 <= port <= 65535) or port in RESERVED_PORTS:
        die("port not allowed")
    values = {"uid": str(uid), "gid": str(gid), "port": str(port), "tz": timezone(),
              "data": str(APPS_DIR / app["id"] / "data")}
    if app.get("password"):
        pw = str(opts.get("password", ""))
        if not re.match(r"^[A-Za-z0-9]{8,64}$", pw):
            die("bad password")
        values["password"] = pw
    folders = opts.get("folders") or {}
    for f in app.get("folders", []):
        if f["key"] not in folders:
            die(f"missing folder: {f['key']}")
        values[f"folder:{f['key']}"] = safe_folder(folders[f["key"]])

    def repl(m):
        key = m.group(1)
        if key not in values:
            die(f"unknown placeholder {key}")
        return values[key]
    return re.sub(r"\{\{([a-z:]+)\}\}", repl, app["compose"])


def project(app_id):
    return f"hsef-{app_id}"


def compose(app_id, *args):
    cmd = compose_cmd()
    if not cmd:
        die("container engine not installed")
    f = APPS_DIR / app_id / "compose.yaml"
    if not f.exists():
        die("app is not installed")
    return run_logged(app_id, *cmd, "-p", project(app_id), "-f", str(f), *args)


# ----------------------------------------------------------------------------- commands
def docker_ok() -> bool:
    """البند 41: المحرك يعمل؟ (بلا انهيار إن لم يوجد أمر docker)."""
    return bool(shutil.which("docker")) and subprocess.run(["docker", "info"], capture_output=True).returncode == 0


def docker_error() -> str:
    """لماذا لا يعمل المحرك؟ أول سطر مفيد من docker info، أو حالة الخدمة."""
    if not shutil.which("docker"):
        return "docker command not found (package docker-cli missing)"
    r = subprocess.run(["docker", "info"], capture_output=True, text=True)
    if r.returncode == 0:
        return ""
    lines = [l.strip() for l in (r.stderr or r.stdout).splitlines() if l.strip()]
    return (lines[-1] if lines else f"docker info exit {r.returncode}")[:300]


def cmd_check():
    docker = FAKE or bool(shutil.which("docker"))
    running = FAKE or docker_ok()
    out = {"docker": docker, "running": bool(running), "compose": bool(compose_cmd()) if docker else False}
    if docker and not running and not FAKE:
        out["error"] = docker_error()   # البند 36: المحرك مثبت لكنه لا يعمل ← السبب
    print(json.dumps(out))


def internet_ok() -> bool:
    """البند 36: تنزيل المحرك يحتاج الإنترنت. نفحصه قبل البدء حتى تظهر رسالة واضحة بدل فشل غامض."""
    if FAKE:
        return os.environ.get("HSEF_FAKE_NO_INTERNET") != "1"
    import socket
    for host in ("deb.debian.org", "security.debian.org"):
        try:
            socket.create_connection((socket.gethostbyname(host), 80), timeout=8).close()
            return True
        except OSError:
            continue
    return False


def apt_has(pkg: str) -> bool:
    r = subprocess.run(["apt-cache", "policy", pkg], capture_output=True, text=True)
    return "Candidate:" in r.stdout and "Candidate: (none)" not in r.stdout


def wait_engine(log, seconds=45) -> bool:
    for _ in range(seconds // 3):
        if docker_ok():
            return True
        time.sleep(3)
    if not shutil.which("docker"):
        log.write("docker command not found (package docker-cli missing)\n")
    log.write("$ systemctl status docker\n"); log.flush()
    subprocess.run(["systemctl", "status", "--no-pager", "-n", "15", "docker"], stdout=log, stderr=subprocess.STDOUT)
    subprocess.run(["journalctl", "-u", "docker", "-b", "--no-pager", "-n", "15"], stdout=log, stderr=subprocess.STDOUT)
    return False


def cmd_setup():
    lid = "_engine"
    log_path(lid).write_text("")
    os.chmod(log_path(lid), 0o644)
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if not internet_ok():
        with open(log_path(lid), "a") as log:
            log.write("no internet connection (deb.debian.org unreachable)\n[exit 1]\n")
        die("no-internet")
    if FAKE:
        run_logged(lid, "apt-get", "install", "docker.io")
        return
    with open(log_path(lid), "a") as log:
        # البند 41: في ديبيان 13 أمر «docker» في حزمة منفصلة (docker-cli) لا تأتي مع --no-install-recommends،
        # فكان المحرك يُثبَّت بلا أمر docker: «FileNotFoundError: docker» ويبقى كل شيء معطلاً.
        log.write("$ apt-get update\n"); log.flush()
        r = subprocess.run(["apt-get", "update"], stdout=log, stderr=subprocess.STDOUT, env=env)
        if r.returncode != 0:
            log.write(f"[exit {r.returncode}]\n")
            die("install-failed")
        pkgs = ["docker.io", "ca-certificates", "iptables"] + [p for p in ("docker-cli", "docker-compose") if apt_has(p)]
        for cmd in (["apt-get", "install", "-y", "--no-install-recommends", *pkgs],):
            log.write(f"$ {' '.join(cmd)}\n"); log.flush()
            r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, env=env)
            if r.returncode != 0:
                log.write(f"[exit {r.returncode}]\n")
                die("install-failed")
        log.write("$ systemctl enable --now docker\n"); log.flush()
        subprocess.run(["systemctl", "enable", "--now", "docker"], stdout=log, stderr=subprocess.STDOUT)
        if not wait_engine(log):   # البند 36: كان يُعلن النجاح والمحرك لا يعمل، فيبقى كل شيء معطلاً بلا رسالة
            log.write("[exit 1]\n")
            die("not-running")
        log.write("[exit 0]\n")


def cmd_start_engine():
    """البند 36: المحرك مثبت لكنه متوقف ← تشغيله من جديد."""
    lid = "_engine"
    if FAKE:
        return
    with open(log_path(lid), "a") as log:
        log.write("$ systemctl restart containerd docker\n"); log.flush()
        subprocess.run(["systemctl", "restart", "containerd", "docker"], stdout=log, stderr=subprocess.STDOUT)
        if not wait_engine(log):
            log.write("[exit 1]\n")
            die("not-running")
        log.write("[exit 0]\n")


def cmd_install(app_id):
    app = app_def(app_id)
    try:
        opts = json.loads((OPTIONS_DIR / f"{app_id}.json").read_text())
    except (OSError, ValueError):
        opts = {}
    text = render(app, opts)
    d = APPS_DIR / app_id
    (d / "data").mkdir(parents=True, exist_ok=True)
    uid, gid = service_ids()
    os.chown(d / "data", uid, gid)
    (d / "compose.yaml").write_text(text)
    log_path(app_id).write_text(f"Installing {app['name']}…\n")
    if compose(app_id, "pull") != 0:
        die("download failed (is the internet connection working?)")
    if compose(app_id, "up", "-d", "--remove-orphans") != 0:
        die("start failed")
    with open(log_path(app_id), "a") as log:
        log.write("[done]\n")


def cmd_simple(action, app_id):
    app_def(app_id)
    if action == "update":
        if compose(app_id, "pull") != 0:
            die("download failed")
        rc = compose(app_id, "up", "-d", "--remove-orphans")
    elif action == "start":
        rc = compose(app_id, "up", "-d")
    elif action == "stop":
        rc = compose(app_id, "stop")
    else:
        rc = compose(app_id, "restart")
    if rc != 0:
        die(f"{action} failed")


def cmd_remove(app_id, purge):
    app_def(app_id)
    d = APPS_DIR / app_id
    if (d / "compose.yaml").exists() and compose_cmd():
        compose(app_id, "down", "--remove-orphans")
    if purge and d.exists():
        shutil.rmtree(d)
    elif (d / "compose.yaml").exists():
        (d / "compose.yaml").unlink()
    (OPTIONS_DIR / f"{app_id}.json").unlink(missing_ok=True)


def cmd_status():
    out = {}
    if not APPS_DIR.exists():
        print("{}")
        return
    for d in sorted(APPS_DIR.iterdir()):
        if not (d / "compose.yaml").exists() or not ID_RE.match(d.name):
            continue
        state = "unknown"
        if FAKE:
            state = "running"
        elif shutil.which("docker"):
            r = subprocess.run(["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project(d.name)}",
                                "--format", "{{.State}}"], capture_output=True, text=True)
            states = r.stdout.split()
            state = "running" if "running" in states else (states[0] if states else "missing")
        out[d.name] = {"state": state}
    print(json.dumps(out))


def cmd_logs(app_id):
    app_def(app_id)
    cmd = compose_cmd()
    f = APPS_DIR / app_id / "compose.yaml"
    if FAKE or not cmd or not f.exists():
        print("(no logs)")
        return
    r = subprocess.run([*cmd, "-p", project(app_id), "-f", str(f), "logs", "--no-color", "--tail", "200"],
                       capture_output=True, text=True, timeout=60)
    print((r.stdout + r.stderr)[-20000:])


def main():
    if os.geteuid() != 0 and not TEST:
        die("must run as root")
    a = sys.argv[1:]
    if a == ["check"]:
        cmd_check()
    elif a == ["setup"]:
        cmd_setup()
    elif a == ["start-engine"]:
        cmd_start_engine()
    elif a == ["status"]:
        cmd_status()
    elif len(a) == 2 and a[0] == "install":
        cmd_install(a[1])
    elif len(a) == 2 and a[0] in ("start", "stop", "restart", "update"):
        cmd_simple(a[0], a[1])
    elif len(a) in (2, 3) and a[0] == "remove":
        cmd_remove(a[1], a[2:] == ["--purge"])
    elif len(a) == 2 and a[0] == "logs":
        cmd_logs(a[1])
    elif len(a) == 2 and a[0] == "custom-add":
        cmd_custom_add(a[1])
    elif len(a) == 2 and a[0] == "custom-remove":
        cmd_custom_remove(a[1])
    else:
        die("usage: hsef-apps check|setup|status|install ID|start ID|stop ID|restart ID|update ID|remove ID [--purge]|logs ID")


if __name__ == "__main__":
    try:
        main()
    except FileNotFoundError as exc:   # البند 41: أمر ناقص ← رسالة قصيرة بدل تتبّع Python
        die(f"missing command: {exc.filename}")
