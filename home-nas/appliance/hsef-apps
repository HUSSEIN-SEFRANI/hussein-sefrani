#!/usr/bin/env python3
"""hsef-apps — root helper for the HOME ANAB App Center (Docker containers).

Called by the web app (user 'homenas') through sudo:

    hsef-apps check                 is the container engine installed? (JSON)
    hsef-apps setup                 install the container engine (Docker)
    hsef-apps install ID            install / reconfigure app ID
    hsef-apps start|stop|restart|update ID
    hsef-apps remove ID [--purge]   remove app (--purge also deletes its settings/data)
    hsef-apps status                state of installed apps (JSON)
    hsef-apps logs ID               last lines of the app's own log

Security: apps come only from the root-owned catalog; the user may only choose a
port and folders. Folders must be under /srv, /mnt or /media (never HOME ANAB's
@system folder). Output of long operations goes to /var/lib/homenas/apps/ID.log.
"""
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
from pathlib import Path

TEST = os.environ.get("HSEF_APPS_TEST") == "1"
FAKE = os.environ.get("HSEF_APPS_FAKE") == "1"
CATALOG = Path(os.environ["HSEF_APPS_CATALOG"]) if TEST else Path("/opt/homenas/app/apps/catalog.json")
OPTIONS_DIR = Path(os.environ.get("HSEF_APPS_OPTIONS", "/etc/homenas/apps")) if TEST else Path("/etc/homenas/apps")
APPS_DIR = Path(os.environ.get("HSEF_APPS_DIR", "/srv/homenas/apps")) if TEST else Path("/srv/homenas/apps")
LOG_DIR = Path(os.environ.get("HSEF_APPS_LOGS", "/var/lib/homenas/apps")) if TEST else Path("/var/lib/homenas/apps")
SERVICE_USER = "homenas"
ALLOWED_ROOTS = ("/srv/", "/mnt/", "/media/")
FORBIDDEN = ("/@system",)
RESERVED_PORTS = {22, 53, 80, 443, 445, 139, 5353, 8200, 631}
ID_RE = re.compile(r"^[a-z0-9]{2,32}$")


def die(msg):
    print(f"hsef-apps: {msg}", file=sys.stderr)
    sys.exit(1)


def catalog() -> dict:
    return {a["id"]: a for a in json.loads(CATALOG.read_text())["apps"]}


def app_def(app_id):
    if not ID_RE.match(app_id or ""):
        die("bad app id")
    apps = catalog()
    if app_id not in apps:
        die("unknown app")
    return apps[app_id]


def log_path(app_id):
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    return LOG_DIR / f"{app_id}.log"


def run_logged(app_id, *cmd, append=True):
    """Run a command, streaming its output into the app's log file."""
    lp = log_path(app_id)
    with open(lp, "a" if append else "w") as log:
        log.write(f"$ {' '.join(cmd)}\n")
        log.flush()
        if FAKE:
            log.write("(test mode: command not executed)\n")
            return 0
        r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT)
        log.write(f"[exit {r.returncode}]\n")
    os.chmod(lp, 0o644)
    return r.returncode


def compose_cmd():
    if FAKE:
        return ["docker", "compose"]
    if shutil.which("docker") and subprocess.run(["docker", "compose", "version"], capture_output=True).returncode == 0:
        return ["docker", "compose"]
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    return None


def service_ids():
    try:
        pw = pwd.getpwnam(SERVICE_USER)
        return pw.pw_uid, pw.pw_gid
    except KeyError:
        return os.getuid(), os.getgid()


def timezone():
    try:
        return os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return "UTC"


def safe_folder(path) -> str:
    p = os.path.realpath(str(path))
    if not any((p + "/").startswith(r) for r in ALLOWED_ROOTS) or any(f in p for f in FORBIDDEN):
        die(f"folder not allowed: {path}")
    if not os.path.isdir(p):
        die(f"folder does not exist: {path}")
    if any(c in p for c in "\"\n\r$`"):
        die("bad characters in folder path")
    return p


def render(app, opts) -> str:
    uid, gid = service_ids()
    port = int(opts.get("port") or app["port"])
    if app.get("fixed_port"):
        port = app["port"]
    if not (1024 <= port <= 65535) or port in RESERVED_PORTS:
        die("port not allowed")
    values = {"uid": str(uid), "gid": str(gid), "port": str(port), "tz": timezone(),
              "data": str(APPS_DIR / app["id"] / "data")}
    if app.get("password"):
        pw = str(opts.get("password", ""))
        if not re.match(r"^[A-Za-z0-9]{8,64}$", pw):
            die("bad password")
        values["password"] = pw
    folders = opts.get("folders") or {}
    for f in app.get("folders", []):
        if f["key"] not in folders:
            die(f"missing folder: {f['key']}")
        values[f"folder:{f['key']}"] = safe_folder(folders[f["key"]])

    def repl(m):
        key = m.group(1)
        if key not in values:
            die(f"unknown placeholder {key}")
        return values[key]
    return re.sub(r"\{\{([a-z:]+)\}\}", repl, app["compose"])


def project(app_id):
    return f"hsef-{app_id}"


def compose(app_id, *args):
    cmd = compose_cmd()
    if not cmd:
        die("container engine not installed")
    f = APPS_DIR / app_id / "compose.yaml"
    if not f.exists():
        die("app is not installed")
    return run_logged(app_id, *cmd, "-p", project(app_id), "-f", str(f), *args)


# ----------------------------------------------------------------------------- commands
def cmd_check():
    docker = FAKE or bool(shutil.which("docker"))
    running = FAKE or (docker and subprocess.run(["docker", "info"], capture_output=True).returncode == 0)
    print(json.dumps({"docker": docker, "running": bool(running), "compose": bool(compose_cmd()) if docker else False}))


def cmd_setup():
    lid = "_engine"
    log_path(lid).write_text("")
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if FAKE:
        run_logged(lid, "apt-get", "install", "docker.io")
        return
    with open(log_path(lid), "a") as log:
        for cmd in (["apt-get", "update"],
                    ["apt-get", "install", "-y", "--no-install-recommends", "docker.io", "docker-compose", "ca-certificates"]):
            log.write(f"$ {' '.join(cmd)}\n"); log.flush()
            r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, env=env)
            if r.returncode != 0:
                log.write(f"[exit {r.returncode}]\n")
                die("installing the container engine failed")
        subprocess.run(["systemctl", "enable", "--now", "docker"], stdout=log, stderr=subprocess.STDOUT)
        log.write("[exit 0]\n")


def cmd_install(app_id):
    app = app_def(app_id)
    try:
        opts = json.loads((OPTIONS_DIR / f"{app_id}.json").read_text())
    except (OSError, ValueError):
        opts = {}
    text = render(app, opts)
    d = APPS_DIR / app_id
    (d / "data").mkdir(parents=True, exist_ok=True)
    uid, gid = service_ids()
    os.chown(d / "data", uid, gid)
    (d / "compose.yaml").write_text(text)
    log_path(app_id).write_text(f"Installing {app['name']}…\n")
    if compose(app_id, "pull") != 0:
        die("download failed (is the internet connection working?)")
    if compose(app_id, "up", "-d", "--remove-orphans") != 0:
        die("start failed")
    with open(log_path(app_id), "a") as log:
        log.write("[done]\n")


def cmd_simple(action, app_id):
    app_def(app_id)
    if action == "update":
        if compose(app_id, "pull") != 0:
            die("download failed")
        rc = compose(app_id, "up", "-d", "--remove-orphans")
    elif action == "start":
        rc = compose(app_id, "up", "-d")
    elif action == "stop":
        rc = compose(app_id, "stop")
    else:
        rc = compose(app_id, "restart")
    if rc != 0:
        die(f"{action} failed")


def cmd_remove(app_id, purge):
    app_def(app_id)
    d = APPS_DIR / app_id
    if (d / "compose.yaml").exists() and compose_cmd():
        compose(app_id, "down", "--remove-orphans")
    if purge and d.exists():
        shutil.rmtree(d)
    elif (d / "compose.yaml").exists():
        (d / "compose.yaml").unlink()
    (OPTIONS_DIR / f"{app_id}.json").unlink(missing_ok=True)


def cmd_status():
    out = {}
    if not APPS_DIR.exists():
        print("{}")
        return
    for d in sorted(APPS_DIR.iterdir()):
        if not (d / "compose.yaml").exists() or not ID_RE.match(d.name):
            continue
        state = "unknown"
        if FAKE:
            state = "running"
        elif shutil.which("docker"):
            r = subprocess.run(["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project(d.name)}",
                                "--format", "{{.State}}"], capture_output=True, text=True)
            states = r.stdout.split()
            state = "running" if "running" in states else (states[0] if states else "missing")
        out[d.name] = {"state": state}
    print(json.dumps(out))


def cmd_logs(app_id):
    app_def(app_id)
    cmd = compose_cmd()
    f = APPS_DIR / app_id / "compose.yaml"
    if FAKE or not cmd or not f.exists():
        print("(no logs)")
        return
    r = subprocess.run([*cmd, "-p", project(app_id), "-f", str(f), "logs", "--no-color", "--tail", "200"],
                       capture_output=True, text=True, timeout=60)
    print((r.stdout + r.stderr)[-20000:])


def main():
    if os.geteuid() != 0 and not TEST:
        die("must run as root")
    a = sys.argv[1:]
    if a == ["check"]:
        cmd_check()
    elif a == ["setup"]:
        cmd_setup()
    elif a == ["status"]:
        cmd_status()
    elif len(a) == 2 and a[0] == "install":
        cmd_install(a[1])
    elif len(a) == 2 and a[0] in ("start", "stop", "restart", "update"):
        cmd_simple(a[0], a[1])
    elif len(a) in (2, 3) and a[0] == "remove":
        cmd_remove(a[1], a[2:] == ["--purge"])
    elif len(a) == 2 and a[0] == "logs":
        cmd_logs(a[1])
    else:
        die("usage: hsef-apps check|setup|status|install ID|start ID|stop ID|restart ID|update ID|remove ID [--purge]|logs ID")


if __name__ == "__main__":
    main()
