#!/usr/bin/env python3
"""hsef-net — root helper that applies H.SEF network sharing settings.

The web app (running as the unprivileged 'homenas' user) may call, via sudo:

    hsef-net apply                 render Samba (SMB) + DLNA config from /etc/homenas/network.json
    hsef-net passwd ID NAME        set the SMB password of H.SEF user ID (password on stdin)
    hsef-net deluser ID            remove SMB access of H.SEF user ID
    hsef-net status                print service status as JSON

Everything is validated here: names, paths and IDs coming from the JSON are
never trusted blindly, and every share is always accessed as the 'homenas' user.
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("HSEF_ROOT", "/"))          # tests can redirect all writes
NO_SYSTEMD = os.environ.get("HSEF_NO_SYSTEMD") == "1"
CONF = ROOT / "etc/homenas/network.json"
SMB_CONF = ROOT / "etc/samba/smb.conf"
USERMAP = ROOT / "etc/samba/hsef-usermap"
HOMES_LINKS = ROOT / "var/lib/homenas/smb-homes"
DLNA_CONF = ROOT / "etc/homenas/minidlna.conf"
DLNA_DB = ROOT / "var/lib/homenas/minidlna"
SERVICE_USER = os.environ.get("HSEF_SERVICE_USER", "homenas")

NAME_RE = re.compile(r"^[A-Za-z0-9_.\-]{2,32}$")
SHARE_BAD = re.compile(r"[\[\]\n\r\\/:*?\"<>|%]")


def die(msg):
    print(f"hsef-net: {msg}", file=sys.stderr)
    sys.exit(1)


def unix_name(uid) -> str:
    uid = int(uid)
    if uid <= 0 or uid > 10 ** 7:
        die("bad user id")
    return f"hsef{uid}"


def safe_path(p) -> str:
    p = str(p)
    if not p.startswith("/") or "\n" in p or "\r" in p or ".." in Path(p).parts:
        die(f"bad path: {p!r}")
    return p


def run(*cmd, check=False, inp=None):
    return subprocess.run(cmd, input=inp, text=True, capture_output=True, check=check)


def systemctl(*args):
    if NO_SYSTEMD or not shutil.which("systemctl"):
        return
    run("systemctl", *args)


def load():
    try:
        return json.loads(CONF.read_text())
    except (OSError, ValueError) as exc:
        die(f"cannot read {CONF}: {exc}")


# ----------------------------------------------------------------------------- SMB
def render_smb(cfg) -> str:
    smb = cfg.get("smb") or {}
    data = Path(safe_path(cfg["data_dir"]))
    users = [u for u in smb.get("users", []) if NAME_RE.match(str(u.get("name", "")))]
    by_id = {int(u["id"]): u for u in users}
    unames = {i: unix_name(i) for i in by_id}
    admins = [unames[i] for i, u in by_id.items() if u.get("admin")]
    server = re.sub(r"[^A-Za-z0-9 ._\-]", "", str(cfg.get("server_name") or "H.SEF"))[:40] or "H.SEF"
    netbios = re.sub(r"[^A-Za-z0-9]", "", server).upper()[:15] or "HSEF"

    out = [f"""# Generated by H.SEF — do not edit (changes are overwritten).
[global]
   workgroup = WORKGROUP
   server string = {server}
   netbios name = {netbios}
   server role = standalone server
   security = user
   map to guest = never
   passdb backend = tdbsam
   username map = {USERMAP}
   server min protocol = SMB2_10
   smb encrypt = if_required
   disable netbios = yes
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   # Apple (iPhone Files app, macOS) compatibility
   vfs objects = catia fruit streams_xattr recycle
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:posix_rename = yes
   fruit:veto_appledouble = no
   fruit:nfs_aces = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes
   # deleted files go to the same recycle bin as the web panel
   recycle:repository = #recycle
   recycle:keeptree = yes
   recycle:versions = yes
   recycle:touch = yes
   recycle:exclude = *.tmp,~$*,.DS_Store
   recycle:exclude_dir = #recycle
   # every user works on the files as the H.SEF service account
   force user = {SERVICE_USER}
   force group = {SERVICE_USER}
   create mask = 0664
   directory mask = 0775
   veto files = /.*.uploading/.*.saving/.*.hnpart/
   hide dot files = yes
"""]
    if users:
        out.append(f"""[home]
   comment = My personal folder
   path = {HOMES_LINKS}/%U
   valid users = {' '.join(unames.values())}
   read only = no
   browseable = yes
""")
    if admins:
        out.append(f"""[Users]
   comment = All users' folders (administrators)
   path = {data / 'homes'}
   valid users = {' '.join(admins)}
   read only = no
""")
    for sh in smb.get("shares", []):
        name = str(sh.get("name", ""))
        if not name or SHARE_BAD.search(name) or name.lower() in ("global", "home", "users", "homes", "printers", "ipc$"):
            continue
        path = safe_path(sh["path"])
        read = {unames[int(i)] for i in sh.get("read", []) if int(i) in unames}
        write = {unames[int(i)] for i in sh.get("write", []) if int(i) in unames} | set(admins)
        valid = sorted(read | write)
        if not valid:
            continue
        comment = re.sub(r"[\n\r]", " ", str(sh.get("comment", "")))[:80]
        out.append(f"""[{name}]
   comment = {comment}
   path = {path}
   valid users = {' '.join(valid)}
   read only = yes
   write list = {' '.join(sorted(write))}
""")
    return "\n".join(out)


def apply_smb(cfg):
    smb = cfg.get("smb") or {}
    users = [u for u in smb.get("users", []) if NAME_RE.match(str(u.get("name", "")))]
    data = Path(safe_path(cfg["data_dir"]))
    # username map: what people type (sara) → internal unix account (hsef7)
    USERMAP.parent.mkdir(parents=True, exist_ok=True)
    USERMAP.write_text("".join(f"{unix_name(u['id'])} = {u['name']}\n" for u in users))
    # per-user home links: /var/lib/homenas/smb-homes/<typed name> → <data>/homes/<name>
    # (%U is the name as typed; phones often capitalise the first letter)
    HOMES_LINKS.mkdir(parents=True, exist_ok=True)
    wanted = {}
    for u in users:
        n = u["name"]
        for variant in {n, n.lower(), n.upper(), n.capitalize()}:
            wanted[variant] = data / "homes" / n
    for link in HOMES_LINKS.iterdir():
        if link.name not in wanted:
            link.unlink()
    for name, target in wanted.items():
        link = HOMES_LINKS / name
        if link.is_symlink() and os.readlink(link) == str(target):
            continue
        if link.exists() or link.is_symlink():
            link.unlink()
        link.symlink_to(target)
    SMB_CONF.parent.mkdir(parents=True, exist_ok=True)
    SMB_CONF.write_text(render_smb(cfg))
    if smb.get("enabled"):
        systemctl("enable", "--now", "smbd")
        systemctl("reload-or-restart", "smbd")
        for svc in ("wsdd2", "wsdd"):
            systemctl("enable", "--now", svc)
        systemctl("disable", "--now", "nmbd")
    else:
        systemctl("disable", "--now", "smbd")
        for svc in ("wsdd2", "wsdd"):
            systemctl("disable", "--now", svc)


# ----------------------------------------------------------------------------- DLNA
def apply_dlna(cfg):
    dlna = cfg.get("dlna") or {}
    server = re.sub(r"[\n\r=]", "", str(cfg.get("server_name") or "H.SEF"))[:40] or "H.SEF"
    dirs = [safe_path(d) for d in dlna.get("dirs", [])]
    DLNA_DB.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Generated by H.SEF — do not edit.",
        f"friendly_name={server}",
        "port=8200",
        f"db_dir={DLNA_DB}",
        f"log_dir={DLNA_DB}",
        "inotify=yes",
        "notify_interval=300",
        "wide_links=yes",
        "root_container=B",
        "album_art_names=Cover.jpg/cover.jpg/Folder.jpg/folder.jpg",
    ] + [f"media_dir={d}" for d in dirs]
    new = "\n".join(lines) + "\n"
    old = DLNA_CONF.read_text() if DLNA_CONF.exists() else ""
    DLNA_CONF.parent.mkdir(parents=True, exist_ok=True)
    DLNA_CONF.write_text(new)
    try:
        shutil.chown(DLNA_DB, SERVICE_USER, SERVICE_USER)
    except (LookupError, PermissionError):
        pass
    if dlna.get("enabled") and dirs:
        if old != new:  # folders changed → full rescan
            for f in DLNA_DB.glob("files.db*"):
                f.unlink()
        systemctl("enable", "hsef-dlna")
        systemctl("restart", "hsef-dlna")
    else:
        systemctl("disable", "--now", "hsef-dlna")


# ----------------------------------------------------------------------------- users
def ensure_unix_user(name):
    if run("id", name).returncode != 0:
        run("useradd", "--system", "-M", "-N", "-g", SERVICE_USER, "-d", "/nonexistent",
            "-s", "/usr/sbin/nologin", name, check=True)


def cmd_passwd(uid, uname):
    if not NAME_RE.match(uname):
        die("bad user name")
    name = unix_name(uid)
    pw = sys.stdin.readline().rstrip("\n")
    if len(pw) < 6:
        die("password too short")
    ensure_unix_user(name)
    r = run("smbpasswd", "-s", "-a", name, inp=f"{pw}\n{pw}\n")
    if r.returncode != 0:
        die(r.stderr.strip() or "smbpasswd failed")
    run("smbpasswd", "-e", name)


def cmd_deluser(uid):
    name = unix_name(uid)
    run("smbpasswd", "-x", name)
    if run("id", name).returncode == 0:
        run("userdel", name)


def cmd_status():
    def active(svc):
        if NO_SYSTEMD or not shutil.which("systemctl"):
            return None
        return run("systemctl", "is-active", svc).stdout.strip() == "active"
    users = []
    if shutil.which("pdbedit"):
        users = [l.split(":")[0] for l in run("pdbedit", "-L").stdout.splitlines() if l.startswith("hsef")]
    print(json.dumps({"smb": active("smbd"), "dlna": active("hsef-dlna"),
                      "smb_users": users, "samba_installed": bool(shutil.which("smbd")),
                      "dlna_installed": bool(shutil.which("minidlnad"))}))


def main():
    if os.geteuid() != 0:
        die("must run as root")
    args = sys.argv[1:]
    if args == ["apply"]:
        cfg = load()
        apply_smb(cfg)
        apply_dlna(cfg)
    elif len(args) == 3 and args[0] == "passwd":
        cmd_passwd(args[1], args[2])
    elif len(args) == 2 and args[0] == "deluser":
        cmd_deluser(args[1])
    elif args == ["status"]:
        cmd_status()
    else:
        die("usage: hsef-net apply | passwd ID NAME | deluser ID | status")


if __name__ == "__main__":
    main()
